<Window x:Class="RetalSystemAPI.Desktop.Views.Accounting.SafeTransactionFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RetalSystemAPI.Desktop.Models.Accounting"
        Title="حركة سحب / إيداع نقدي" Height="450" Width="480"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="{DynamicResource SurfaceBrush}" ResizeMode="NoResize" Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="سحب / إيداع يدوي في الخزينة" 
                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Safe.Name, StringFormat={}الخزينة المستهدفة: {0}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Safe.CurrentBalance, StringFormat={}الرصيد الحالي المتوفر: {0:N2} د.ل}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="نوع واتجاه الحركة *" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox SelectedValue="{Binding Direction}" SelectedValuePath="Tag" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,12">
                    <ComboBoxItem Content="وارد / إيداع نقدي (+)" Tag="{x:Static models:TransactionDirection.Inbound}" IsSelected="True"/>
                    <ComboBoxItem Content="صادر / سحب نقدي (-)" Tag="{x:Static models:TransactionDirection.Outbound}"/>
                </ComboBox>

                <TextBlock Text="المبلغ (د.ل) *" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Height="36" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource SurfaceHoverBrush}" Margin="0,0,0,12"/>

                <TextBlock Text="البيان / سبب الحركة *" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Height="36" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource SurfaceHoverBrush}" Margin="0,0,0,12"/>

                <TextBlock Text="ملاحظات إضافية" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" Padding="8" Background="{DynamicResource SurfaceHoverBrush}" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="تنفيذ الحركة" Command="{Binding SaveCommand}" Width="120" Height="36" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryOnBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="إلغاء" IsCancel="True" Width="80" Height="36" Margin="10,0,0,0" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
