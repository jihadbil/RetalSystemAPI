<UserControl x:Class="RetalSystemAPI.Desktop.Views.Accounting.SafesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RetalSystemAPI.Desktop.Controls"
             xmlns:models="clr-namespace:RetalSystemAPI.Desktop.Models.Accounting"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000" 
             FlowDirection="RightToLeft" 
             Background="{DynamicResource BackgroundBrush}" 
             Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="⇄ تحويل أموال" Command="{Binding TransferFundsCommand}" Height="36" Padding="14,0" Margin="0,0,8,0" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="+ إضافة خزينة / حساب" Command="{Binding CreateSafeCommand}" Height="36" Padding="14,0" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryOnBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource IconSafe}" Fill="{DynamicResource PrimaryBrush}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,10,0"/>
                <TextBlock Text="الخزن والحسابات المصرفية" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- Metric KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Liquidity Card -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي السيولة النقدية" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding TotalLiquidity, StringFormat={}{0:N2} د.ل}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Coffers Card -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16" Margin="4,0,4,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="الصناديق والخزن الرئيسية" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding CoffersCount, StringFormat={}{0} خزينة}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Bank Accounts Card -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16" Margin="4,0,4,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="الحسابات المصرفية" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding BanksCount, StringFormat={}{0} حساب}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Drawers Card -->
            <Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16" Margin="8,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="أدراج نقاط البيع (الكاشير)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding DrawersCount, StringFormat={}{0} درج}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filters Bar Card -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="الفرع:" VerticalAlignment="Center" Margin="5,0,8,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="النوع:" VerticalAlignment="Center" Margin="12,0,8,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ComboBox Grid.Column="3" SelectedValue="{Binding SelectedType}" SelectedValuePath="Tag" Height="34" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="الكل" Tag="{x:Null}" IsSelected="True"/>
                    <ComboBoxItem Content="صندوق / خزينة" Tag="{x:Static models:SafeType.CashBox}"/>
                    <ComboBoxItem Content="حساب بنكي" Tag="{x:Static models:SafeType.Bank}"/>
                    <ComboBoxItem Content="درج كاشير" Tag="{x:Static models:SafeType.CashDrawer}"/>
                </ComboBox>

                <TextBlock Grid.Column="4" Text="بحث:" VerticalAlignment="Center" Margin="12,0,8,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox Grid.Column="5" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                <Button Grid.Column="6" Content="تحديث" Command="{Binding LoadSafesCommand}" Margin="10,0,0,0" Padding="15,0" Height="34" Background="{DynamicResource TextPrimaryBrush}" Foreground="{DynamicResource SurfaceBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- DataGrid Card -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Safes}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" Background="Transparent" RowHeight="44">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم الخزينة / الحساب" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="1.5*"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding TypeName}" Width="1.2*"/>
                    <DataGridTextColumn Header="الرصيد الحالي المتوفر" Binding="{Binding CurrentBalance, StringFormat={}{0:N2} د.ل}" Width="1.5*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="الحالة" Width="0.9*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IsActive, Converter={StaticResource StatusTextConverter}}" 
                                           Foreground="{Binding IsActive, Converter={StaticResource StatusToColorConverter}}" 
                                           FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="الإجراءات والعمليات" Width="320">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource GhostButtonStyle}" Content="إيداع/سحب" Command="{Binding DataContext.DepositWithdrawCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="6,4" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Content="سجل الحركات" Command="{Binding DataContext.ViewLedgerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="6,4" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Content="تعديل" Command="{Binding DataContext.EditSafeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="6,4" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="تفعيل/تعطيل" Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="6,4" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                    <Button Style="{StaticResource TextButtonStyle}" Foreground="{DynamicResource DangerBrush}" Content="حذف" Command="{Binding DataContext.DeleteSafeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="6,4" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination & Messages -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,6" />
            <controls:PaginationControl CurrentPage="{Binding CurrentPage}" TotalPages="{Binding TotalPages}" PageSize="{Binding PageSize, Mode=TwoWay}" IsLoading="{Binding IsLoading}" NextPageCommand="{Binding NextPageCommand}" PrevPageCommand="{Binding PrevPageCommand}" />
        </StackPanel>

        <!-- Empty State & Loading Overlay -->
        <controls:ListFeedback Grid.Row="3" ItemsCount="{Binding Safes.Count}" IsLoading="{Binding IsLoading}" Message="{Binding ErrorMessage}" RetryCommand="{Binding LoadSafesCommand}" />
        <controls:LoadingOverlay Grid.RowSpan="5" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>
