<Window x:Class="RetalSystemAPI.Desktop.Views.Accounting.SafeLedgerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RetalSystemAPI.Desktop.Controls"
        xmlns:models="clr-namespace:RetalSystemAPI.Desktop.Models.Accounting"
        Title="سجل وحركات الخزينة" Height="650" Width="950"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="الرصيد اللحظي الحالي:" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding CurrentBalance, StringFormat={}{0:N2} د.ل}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconStatement}" Fill="{DynamicResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding SafeName, StringFormat={}سجل حركات: {0}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Filters Bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="من تاريخ:" VerticalAlignment="Center" Margin="5,0,8,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="إلى تاريخ:" VerticalAlignment="Center" Margin="12,0,8,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate}" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="4" Text="الاتجاه:" VerticalAlignment="Center" Margin="12,0,8,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ComboBox Grid.Column="5" SelectedValue="{Binding SelectedDirection}" SelectedValuePath="Tag" Height="34" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="الكل" Tag="{x:Null}" IsSelected="True"/>
                    <ComboBoxItem Content="وارد (+)" Tag="{x:Static models:TransactionDirection.Inbound}"/>
                    <ComboBoxItem Content="صادر (-)" Tag="{x:Static models:TransactionDirection.Outbound}"/>
                </ComboBox>

                <Button Grid.Column="6" Content="عرض الحركات" Command="{Binding LoadTransactionsCommand}" Margin="12,0,0,0" Padding="16,0" Height="34" Background="{DynamicResource TextPrimaryBrush}" Foreground="{DynamicResource SurfaceBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" Background="Transparent" RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الحركة" Binding="{Binding TransactionNumber}" Width="1.3*"/>
                    <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding TransactionDate, StringFormat={}{0:yyyy/MM/dd HH:mm}}" Width="1.4*"/>
                    <DataGridTextColumn Header="نوع المستند" Binding="{Binding DocumentTypeName}" Width="1.2*"/>
                    <DataGridTextColumn Header="الاتجاه" Binding="{Binding DirectionName}" Width="1*"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N2} د.ل}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="الرصيد بعد الحركة" Binding="{Binding BalanceAfter, StringFormat={}{0:N2} د.ل}" Width="1.3*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="البيان والتفاصيل" Binding="{Binding Description}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination & Overlay -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,6" />
            <controls:PaginationControl CurrentPage="{Binding CurrentPage}" TotalPages="{Binding TotalPages}" PageSize="{Binding PageSize, Mode=TwoWay}" IsLoading="{Binding IsLoading}" NextPageCommand="{Binding NextPageCommand}" PrevPageCommand="{Binding PrevPageCommand}" />
        </StackPanel>

        <controls:ListFeedback Grid.Row="2" ItemsCount="{Binding Transactions.Count}" IsLoading="{Binding IsLoading}" Message="{Binding ErrorMessage}" RetryCommand="{Binding LoadTransactionsCommand}" />
        <controls:LoadingOverlay Grid.RowSpan="4" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</Window>
