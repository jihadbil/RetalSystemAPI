<Window x:Class="RetalSystemAPI.Desktop.Views.Users.UserPermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تخصيص صلاحيات المستخدم" 
        Height="740" Width="1060"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" 
        FlowDirection="RightToLeft" 
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="📋 نسخ صلاحيات الدور كقالب" Command="{Binding CopyRolePermissionsCommand}" Height="36" Padding="12,0" Margin="0,0,8,0" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                    <Button Content="تحديد الكل" Command="{Binding SelectAllCommand}" Height="36" Padding="12,0" Margin="0,0,8,0" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                    <Button Content="إلغاء تحديد الكل" Command="{Binding DeselectAllCommand}" Height="36" Padding="12,0" Margin="0,0,12,0" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                    <Button Content="💾 حفظ صلاحيات المستخدم" Command="{Binding SavePermissionsCommand}" Height="36" Padding="20,0" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryOnBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡️ تخصيص صلاحيات المستخدم: " FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding UserName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="الدور المسند: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UserRolesDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Mode Selection Banner -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Border Visibility="{Binding IsAdminUser, Converter={StaticResource BoolToVisibilityConverter}}" Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="12,6" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="👑 مدير النظام: يمتلك صلاحيات شاملة لكافة الشاشات والإجراءات دون قيود" Foreground="{DynamicResource PrimaryOnBrush}" FontWeight="Bold" FontSize="12"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="نمط تطبيق الصلاحيات على هذا المستخدم:" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="وراثة الصلاحيات تلقائياً من الدور" 
                                     IsChecked="{Binding IsCustomized, Converter={StaticResource InverseBoolConverter}}" 
                                     GroupName="UserPermMode" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,24,0"/>
                        <RadioButton Content="تخصيص صلاحيات مستقلة خاصة بهذا المستخدم (تتجاوز صلاحيات الدور)" 
                                     IsChecked="{Binding IsCustomized}" 
                                     GroupName="UserPermMode" FontWeight="Bold" Cursor="Hand" Foreground="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Permissions Matrix Card -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hint Bar when in Inherit Mode -->
                <Border Grid.Row="0" Visibility="{Binding IsCustomized, Converter={StaticResource InverseBoolToVisibilityConverter}}" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <TextBlock Text="ℹ️ الصلاحيات أدناه معروضة وفق قالب الدور المسند للمستخدم. لتعديلها وتحديد شاشات وإجراءات خاصة به، اختر 'تخصيص صلاحيات مستقلة خاصة بهذا المستخدم'." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold"/>
                </Border>

                <!-- Permission Groups List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PermissionGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <!-- Group Header -->
                                        <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                            <Border DockPanel.Dock="Left" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6" Padding="8,3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding SummaryDisplay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📂 " FontSize="13"/>
                                                <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Permissions CheckBoxes Grid -->
                                        <ItemsControl ItemsSource="{Binding Permissions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="330" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,10,8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                                        <CheckBox IsChecked="{Binding IsGranted, Mode=TwoWay}" 
                                                                  IsEnabled="{Binding DataContext.IsAdminUser, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolConverter}}"
                                                                  VerticalContentAlignment="Center" Cursor="Hand">
                                                            <StackPanel Margin="6,0,0,0">
                                                                <DockPanel LastChildFill="True">
                                                                    <Border Visibility="{Binding IsScreenAccess, Converter={StaticResource BoolToVisibilityConverter}}" Background="#1A3B82F6" CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="دخول شاشة" FontSize="9" FontWeight="Bold" Foreground="#3B82F6"/>
                                                                    </Border>
                                                                    <Border Visibility="{Binding IsScreenAccess, Converter={StaticResource InverseBoolToVisibilityConverter}}" Background="#1A10B981" CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="إجراء عملي" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer Card -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <DockPanel LastChildFill="True">
                <Button Content="إغلاق النافذة" IsCancel="True" Height="36" Padding="22,0" HorizontalAlignment="Right" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
