<UserControl x:Class="RetalSystemAPI.Desktop.Views.Users.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RetalSystemAPI.Desktop.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950" FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="🛡️ إدارة الأدوار ومصفوفة الصلاحيات" Command="{Binding ManageRolesPermissionsCommand}" Visibility="{Binding CanManageRoles, Converter={StaticResource BoolToVisibilityConverter}}" Height="36" Padding="14,0" Margin="0,0,10,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="+ إضافة مستخدم جديد" Command="{Binding CreateUserCommand}" Visibility="{Binding CanCreateUser, Converter={StaticResource BoolToVisibilityConverter}}" Height="36" Padding="16,0" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryOnBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
            <TextBlock Text="👤 إدارة المستخدمين والصلاحيات" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Toolbar / Filters Card -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🔍 بحث:" VerticalAlignment="Center" Margin="5,0,10,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                <TextBlock Grid.Column="2" Text="🏪 الفرع:" VerticalAlignment="Center" Margin="15,0,10,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranchFilter}" DisplayMemberPath="Name" Height="34" VerticalContentAlignment="Center" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                <Button Grid.Column="4" Content="تحديث" Command="{Binding LoadUsersCommand}" Margin="10,0,0,0" Padding="15,0" Height="34" Background="{DynamicResource TextPrimaryBrush}" Foreground="{DynamicResource SurfaceBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- DataGrid Card -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" Background="Transparent" RowHeight="44">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding UserName}" Width="1.5*"/>
                    <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Email}" Width="2*"/>
                    <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding PhoneNumber}" Width="1.2*"/>
                    <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="1.5*"/>
                    <DataGridTextColumn Header="الدور / الصلاحية" Binding="{Binding RolesDisplay}" Width="1.5*"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusDisplay}" Width="1*"/>

                    <DataGridTemplateColumn Header="الإجراءات" Width="330">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource GhostButtonStyle}" Visibility="{Binding DataContext.CanManageRoles, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="{DynamicResource PrimaryBrush}" Content="🛡️ الصلاحيات" Command="{Binding DataContext.OpenUserPermissionsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="تخصيص صلاحيات هذا المستخدم بشكل مستقل"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Visibility="{Binding DataContext.CanEditUser, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="{DynamicResource TextPrimaryBrush}" Content="تعديل" Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="كلمة المرور" Visibility="{Binding DataContext.CanResetPassword, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" Background="{DynamicResource WarningBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                    <Button Style="{StaticResource TextButtonStyle}" Visibility="{Binding DataContext.CanDeleteUser, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="{DynamicResource DangerBrush}" Content="حذف" Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination -->
        <controls:PaginationControl Grid.Row="3" Margin="0,12,0,0" CurrentPage="{Binding CurrentPage}" TotalPages="{Binding TotalPages}" PageSize="{Binding PageSize, Mode=TwoWay}" IsLoading="{Binding IsLoading}" NextPageCommand="{Binding NextPageCommand}" PrevPageCommand="{Binding PrevPageCommand}" />
        <controls:ListFeedback Grid.Row="2" ItemsCount="{Binding Users.Count}" IsLoading="{Binding IsLoading}" Message="{Binding ErrorMessage}" RetryCommand="{Binding LoadUsersCommand}" />
        <controls:LoadingOverlay Grid.RowSpan="4" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>
