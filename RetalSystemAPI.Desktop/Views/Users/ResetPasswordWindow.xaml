<Window x:Class="RetalSystemAPI.Desktop.Views.Users.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعادة تعيين كلمة المرور" Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF" FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔑 إعادة تعيين كلمة المرور" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="للمستخدم: " Foreground="#6B7280" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding UserName}" Foreground="#38E07B" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <StackPanel>
                <TextBlock Text="كلمة المرور الجديدة *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" Padding="10,0" Background="#F9FAFB" BorderBrush="#D1D5DB"/>
            </StackPanel>

            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="تأكيد كلمة المرور *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" Padding="10,0" Background="#F9FAFB" BorderBrush="#D1D5DB"/>
            </StackPanel>
        </StackPanel>

        <!-- Error Message -->
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="#EF4444" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,10"/>

        <!-- Action Buttons -->
        <DockPanel Grid.Row="3">
            <Button Content="تغيير كلمة المرور" Command="{Binding SaveCommand}" DockPanel.Dock="Left" Height="38" Padding="20,0" Background="#F59E0B" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="إلغاء" IsCancel="True" HorizontalAlignment="Right" Height="38" Padding="18,0" Background="#F3F4F6" Foreground="#374151" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
