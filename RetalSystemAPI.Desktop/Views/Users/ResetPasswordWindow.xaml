<Window x:Class="RetalSystemAPI.Desktop.Views.Users.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعادة تعيين كلمة المرور" Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}" FlowDirection="RightToLeft" Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔑 إعادة تعيين كلمة المرور" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="للمستخدم: " Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding UserName}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <StackPanel>
                <TextBlock Text="كلمة المرور الجديدة *" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <PasswordBox PasswordChanged="NewPassword_Changed" AutomationProperties.Name="كلمة المرور الجديدة" FlowDirection="LeftToRight" Height="38" VerticalContentAlignment="Center" Padding="10,0" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
            </StackPanel>

            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="تأكيد كلمة المرور *" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <PasswordBox PasswordChanged="ConfirmPassword_Changed" AutomationProperties.Name="تأكيد كلمة المرور" FlowDirection="LeftToRight" Height="38" VerticalContentAlignment="Center" Padding="10,0" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Error Message -->
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,10"/>

        <!-- Action Buttons -->
        <DockPanel Grid.Row="3">
            <Button Content="تغيير كلمة المرور" Command="{Binding SaveCommand}" DockPanel.Dock="Left" Height="38" Padding="20,0" Background="{DynamicResource WarningBrush}" Foreground="{DynamicResource SurfaceBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="إلغاء" IsCancel="True" HorizontalAlignment="Right" Height="38" Padding="18,0" Background="{DynamicResource SurfaceActiveBrush}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
