<Window x:Class="RetalSystemAPI.Desktop.Views.Users.RolePermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مصفوفة إدارة الأدوار وصلاحيات النظام" 
        Height="720" Width="1060"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" 
        FlowDirection="RightToLeft" 
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="تحديد الكل" Command="{Binding SelectAllCommand}" Height="36" Padding="14,0" Margin="0,0,8,0" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                    <Button Content="إلغاء تحديد الكل" Command="{Binding DeselectAllCommand}" Height="36" Padding="14,0" Margin="0,0,12,0" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                    <Button Content="💾 حفظ الصلاحيات" Command="{Binding SavePermissionsCommand}" Height="36" Padding="20,0" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryOnBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🛡️ مصفوفة إدارة الأدوار وصلاحيات النظام" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="تخصيص أذونات الدخول للشاشات وإجراءات العمل لكل دور في النظام" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content (2 Columns: Roles List on Right, Permissions Matrix on Left) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Roles List Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="الأدوار المعرفة بالنظام" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryOnBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="🔒" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Add New Role Panel -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="+ إضافة دور جديد" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <DockPanel>
                                <Button Content="إضافة" Command="{Binding CreateRoleCommand}" DockPanel.Dock="Left" Height="32" Padding="12,0" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryOnBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                <TextBox Text="{Binding NewRoleName, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,6,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                            </DockPanel>
                            <Button Content="🗑️ حذف الدور المحدد" Command="{Binding DeleteRoleCommand}" Height="30" Margin="0,8,0,0" Background="Transparent" Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Column 2: Permissions Matrix -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Selected Role Header Banner -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Border Visibility="{Binding IsAdminRole, Converter={StaticResource BoolToVisibilityConverter}}" Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="👑 مدير النظام: يمتلك صلاحيات شاملة لكافة الشاشات والإجراءات تلقائياً" Foreground="{DynamicResource PrimaryOnBrush}" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="تعديل صلاحيات الدور: " Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding SelectedRole.Name}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="15" Margin="0,0,8,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Permission Groups List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding PermissionGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <!-- Group Header -->
                                            <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                                <Border DockPanel.Dock="Left" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6" Padding="8,3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding SummaryDisplay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📂 " FontSize="13"/>
                                                    <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Permissions CheckBoxes Grid -->
                                            <ItemsControl ItemsSource="{Binding Permissions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="330" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,10,8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                                            <CheckBox IsChecked="{Binding IsGranted, Mode=TwoWay}" 
                                                                      IsEnabled="{Binding DataContext.IsAdminRole, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolConverter}}"
                                                                      VerticalContentAlignment="Center" Cursor="Hand">
                                                                <StackPanel Margin="6,0,0,0">
                                                                    <DockPanel LastChildFill="True">
                                                                        <Border Visibility="{Binding IsScreenAccess, Converter={StaticResource BoolToVisibilityConverter}}" Background="#1A3B82F6" CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="دخول شاشة" FontSize="9" FontWeight="Bold" Foreground="#3B82F6"/>
                                                                        </Border>
                                                                        <Border Visibility="{Binding IsScreenAccess, Converter={StaticResource InverseBoolToVisibilityConverter}}" Background="#1A10B981" CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="إجراء عملي" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Card -->
        <Border Grid.Row="2" Margin="0,15,0,0">
            <DockPanel LastChildFill="True">
                <Button Content="إغلاق النافذة" IsCancel="True" Height="36" Padding="20,0" HorizontalAlignment="Right" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
