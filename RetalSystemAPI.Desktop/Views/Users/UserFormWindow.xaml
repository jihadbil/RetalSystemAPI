<Window x:Class="RetalSystemAPI.Desktop.Views.Users.UserFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بيانات المستخدم" Height="500" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF" FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="👤 بيانات حساب المستخدم" FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>

        <!-- Form Controls -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- User Name -->
                <StackPanel>
                    <TextBlock Text="اسم المستخدم *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditMode}" Height="38" VerticalContentAlignment="Center" Padding="10,0" Background="#F9FAFB" BorderBrush="#D1D5DB"/>
                </StackPanel>

                <!-- Email -->
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="البريد الإلكتروني" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" Padding="10,0" Background="#F9FAFB" BorderBrush="#D1D5DB"/>
                </StackPanel>

                <!-- Phone -->
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="رقم الهاتف" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" Padding="10,0" Background="#F9FAFB" BorderBrush="#D1D5DB"/>
                </StackPanel>

                <!-- Password (New User only) -->
                <StackPanel Margin="0,10,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="كلمة المرور *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" Padding="10,0" Background="#F9FAFB" BorderBrush="#D1D5DB"/>
                </StackPanel>

                <!-- Branch Selection -->
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="الفرع *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name" Height="38" VerticalContentAlignment="Center" Background="#F9FAFB" BorderBrush="#D1D5DB"/>
                </StackPanel>

                <!-- Role Selection -->
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="الدور / الصلاحية" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name" Height="38" VerticalContentAlignment="Center" Background="#F9FAFB" BorderBrush="#D1D5DB"/>
                </StackPanel>

                <!-- Active Status -->
                <CheckBox Content="الحساب نشط ويحق له تسجيل الدخول" IsChecked="{Binding IsActive}" FontWeight="SemiBold" Foreground="#374151" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Error Message -->
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="#EF4444" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,10"/>

        <!-- Action Buttons -->
        <DockPanel Grid.Row="3">
            <Button Content="حفظ البيانات" Command="{Binding SaveCommand}" DockPanel.Dock="Left" Height="40" Padding="24,0" Background="#38E07B" Foreground="#0F291E" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="إلغاء" IsCancel="True" HorizontalAlignment="Right" Height="40" Padding="20,0" Background="#F3F4F6" Foreground="#374151" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
