<Window x:Class="RetalSystemAPI.Desktop.Views.Sales.SalesInvoiceFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sales="clr-namespace:RetalSystemAPI.Desktop.Models.Sales"
        Title="إصدار فاتورة مبيعات" Height="700" Width="850"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="#FFFFFF" ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="{Binding IsEditMode, Converter={StaticResource StatusTextConverter}, FallbackValue='إصدار فاتورة مبيعات جديدة'}" 
                   FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Master Info -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="رقم الفاتورة *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center" Padding="8,0" Background="#F9FAFB"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,6,0">
                        <TextBlock Text="الفرع *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name" Height="36" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                        <TextBlock Text="صالة العرض / المخزن *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" Height="36" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="العميل" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Height="36" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,6,0">
                        <TextBlock Text="طريقة الدفع" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding PaymentMethod}" SelectedValuePath="Tag" Height="36" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="نقداً" Tag="{x:Static sales:PaymentMethod.Cash}" IsSelected="True"/>
                            <ComboBoxItem Content="بطاقة مصرفية" Tag="{x:Static sales:PaymentMethod.Card}"/>
                            <ComboBoxItem Content="تحويل مصرفي" Tag="{x:Static sales:PaymentMethod.BankTransfer}"/>
                            <ComboBoxItem Content="آجل (على الحساب)" Tag="{x:Static sales:PaymentMethod.Credit}"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                        <TextBlock Text="حالة الفاتورة" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding Status}" SelectedValuePath="Tag" Height="36" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="مسودة" Tag="{x:Static sales:InvoiceStatus.Draft}"/>
                            <ComboBoxItem Content="مصدرة" Tag="{x:Static sales:InvoiceStatus.Issued}" IsSelected="True"/>
                            <ComboBoxItem Content="مدفوعة بالكامل" Tag="{x:Static sales:InvoiceStatus.Paid}"/>
                            <ComboBoxItem Content="مدفوعة جزئياً" Tag="{x:Static sales:InvoiceStatus.PartiallyPaid}"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Add Items Section -->
                <Border Background="#F9FAFB" CornerRadius="8" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🛒 إضافة بنود الأصناف للفاتورة" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="الصنف" FontSize="11" Foreground="#6B7280"/>
                                <ComboBox ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProductToAdd}" DisplayMemberPath="Name" Height="34" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="الكمية" FontSize="11" Foreground="#6B7280"/>
                                <TextBox Text="{Binding QuantityToAdd, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="6,0" Background="#FFFFFF"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                <TextBlock Text="سعر الوحدة" FontSize="11" Foreground="#6B7280"/>
                                <TextBox Text="{Binding UnitPriceToAdd, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="6,0" Background="#FFFFFF"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="4,0,4,0">
                                <TextBlock Text="الخصم" FontSize="11" Foreground="#6B7280"/>
                                <TextBox Text="{Binding DiscountToAdd, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="6,0" Background="#FFFFFF"/>
                            </StackPanel>

                            <Button Grid.Column="4" Content="+ إضافة بند" Command="{Binding AddItemCommand}" VerticalAlignment="Bottom" Height="34" Padding="14,0" Background="#38E07B" Foreground="#0F291E" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <!-- Items DataGrid -->
                        <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="140" MaxHeight="200" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" Width="2*"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="1*"/>
                                <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat={}{0:N2} د.ل}" Width="1.2*"/>
                                <DataGridTextColumn Header="الخصم" Binding="{Binding DiscountAmount, StringFormat={}{0:N2} د.ل}" Width="1*"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat={}{0:N2} د.ل}" Width="1.2*"/>
                                <DataGridTemplateColumn Header="حذف" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Width="24" Height="24" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Calculations Summary Card -->
                <Border Background="#F3F4F6" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="المجموع الفرعي:" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBlock Text="{Binding SubTotal, StringFormat={}{0:N2} د.ل}" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6,0,6,0">
                            <TextBlock Text="الخصم الكلي:" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" Padding="4,0" Background="#FFFFFF"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="6,0,6,0">
                            <TextBlock Text="المبلغ المدفوع:" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" Padding="4,0" Background="#FFFFFF"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="6,0,0,0">
                            <TextBlock Text="المتبقي (الدين):" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBlock Text="{Binding RemainingAmount, StringFormat={}{0:N2} د.ل}" FontSize="16" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="ملاحظات" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#F9FAFB"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="إصدار وحفظ الفاتورة" Command="{Binding SaveCommand}" DockPanel.Dock="Left" Height="40" Padding="24,0" Background="#38E07B" Foreground="#0F291E" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
