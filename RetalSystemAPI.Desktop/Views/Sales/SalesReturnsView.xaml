<UserControl x:Class="RetalSystemAPI.Desktop.Views.Sales.SalesReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sales="clr-namespace:RetalSystemAPI.Desktop.Models.Sales"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950" FlowDirection="RightToLeft" Background="#F6F8F7">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <Button Content="+ تسجيل مرتجع جديد" Command="{Binding CreateReturnCommand}" DockPanel.Dock="Left" Height="36" Padding="16,0" Background="#38E07B" Foreground="#0F291E" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <TextBlock Text="🔄 مرتجعات المبيعات واسترجاع البضائع" FontSize="22" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Filter Bar Card -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="5,0,5,0" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#F9FAFB"/>

                <TextBlock Grid.Column="2" Text="الفرع:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold" Foreground="#111827"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="4" Text="المستودع:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold" Foreground="#111827"/>
                <ComboBox Grid.Column="5" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="6" Text="السبب:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold" Foreground="#111827"/>
                <ComboBox Grid.Column="7" SelectedValue="{Binding SelectedReason}" SelectedValuePath="Tag" Height="34" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="الكل" Tag="{x:Null}" IsSelected="True"/>
                    <ComboBoxItem Content="تراجع العميل" Tag="{x:Static sales:SalesReturnReason.CustomerChangedMind}"/>
                    <ComboBoxItem Content="تالف / مكسور" Tag="{x:Static sales:SalesReturnReason.Damaged}"/>
                    <ComboBoxItem Content="معيب / غير صالح" Tag="{x:Static sales:SalesReturnReason.Defective}"/>
                    <ComboBoxItem Content="منتهي الصلاحية" Tag="{x:Static sales:SalesReturnReason.Expired}"/>
                    <ComboBoxItem Content="صنف خاطئ" Tag="{x:Static sales:SalesReturnReason.WrongItem}"/>
                </ComboBox>

                <Button Grid.Column="8" Content="تحديث" Command="{Binding LoadReturnsCommand}" Margin="10,0,0,0" Padding="15,0" Height="34" Background="#111827" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- DataGrid Card -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Returns}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="#F3F4F6" Background="Transparent" RowHeight="42">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم المرتجع" Binding="{Binding ReturnNumber}" Width="1.5*"/>
                    <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="1.2*"/>
                    <DataGridTextColumn Header="المستودع المستلم" Binding="{Binding WarehouseName}" Width="1.4*"/>
                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName, TargetNullValue='عميل نقدي / عام'}" Width="1.5*"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding ReturnDate, StringFormat={}{0:yyyy-MM-dd}}" Width="1.1*"/>
                    <DataGridTextColumn Header="السبب" Binding="{Binding ReasonName}" Width="1.3*"/>
                    <DataGridTextColumn Header="قيمة المرتجع" Binding="{Binding TotalAmount, StringFormat={}{0:N2} د.ل}" Width="1.3*"/>
                    <DataGridTextColumn Header="عدد الأصناف" Binding="{Binding ItemCount}" Width="1*"/>
                    <DataGridTemplateColumn Header="الإجراءات" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="عرض التفاصيل" Command="{Binding DataContext.ViewReturnDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="حذف" Command="{Binding DataContext.DeleteReturnCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination -->
        <DockPanel Grid.Row="3" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="السابق" Command="{Binding PrevPageCommand}" Height="32" Padding="14,0" Margin="0,0,5,0" Background="#FFFFFF" Foreground="#111827" FontWeight="Bold" BorderBrush="#E5E7EB" BorderThickness="1" Cursor="Hand"/>
                <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#38E07B" Margin="5,0"/>
                <TextBlock Text="من" VerticalAlignment="Center" Foreground="#6B7280" Margin="2,0"/>
                <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#111827" Margin="5,0"/>
                <Button Content="التالي" Command="{Binding NextPageCommand}" Height="32" Padding="14,0" Margin="5,0,0,0" Background="#FFFFFF" Foreground="#111827" FontWeight="Bold" BorderBrush="#E5E7EB" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</UserControl>
