<UserControl x:Class="RetalSystemAPI.Desktop.Views.Pos.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sales="clr-namespace:RetalSystemAPI.Desktop.Models.Sales"
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="1180" FlowDirection="RightToLeft" Background="#F3F4F6">

    <UserControl.Resources>
        <!-- Product Tile Card Style -->
        <Style x:Key="ProductCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" Padding="12">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0FDF4"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38E07B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DCFCE7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category Filter Pill Style -->
        <Style x:Key="CategoryPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pillBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#38E07B"/>
                                <Setter Property="Foreground" Value="#0F291E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════ TOP CONTROL & FILTER BAR ════════ -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="12" Padding="14" Margin="0,0,0,14" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Branch -->
                <TextBlock Grid.Column="0" Text="🏢 الفرع:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#374151"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name" Height="36" VerticalContentAlignment="Center" Margin="0,0,12,0"/>

                <!-- Showroom Warehouse -->
                <TextBlock Grid.Column="2" Text="🏪 الصالة/المخزن:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#374151"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" Height="36" VerticalContentAlignment="Center" Margin="0,0,12,0"/>

                <!-- Customer -->
                <TextBlock Grid.Column="4" Text="👤 العميل:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#374151"/>
                <ComboBox Grid.Column="5" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Height="36" VerticalContentAlignment="Center" Margin="0,0,12,0"/>

                <!-- Barcode Fast Scanner Input -->
                <TextBlock Grid.Column="6" Text="🏷️ الباركود:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#10B981"/>
                <TextBox Grid.Column="7" x:Name="BarcodeTextBox" Text="{Binding BarcodeQuery, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center" Padding="8,0" Background="#F0FDF4" BorderBrush="#38E07B" BorderThickness="1.5" Margin="0,0,12,0" KeyDown="BarcodeTextBox_KeyDown" ToolTip="امسح الباركود أو اضغط Enter للإضافة الفورية"/>

                <!-- Search Input -->
                <TextBlock Grid.Column="8" Text="🔍 بحث:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#374151"/>
                <TextBox Grid.Column="9" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center" Padding="8,0" Background="#F9FAFB"/>

                <!-- Refresh Button -->
                <Button Grid.Column="10" Content="🔄" Command="{Binding RefreshCommand}" Width="36" Height="36" Background="#F3F4F6" FontWeight="Bold" BorderThickness="1" BorderBrush="#E5E7EB" Cursor="Hand" ToolTip="تحديث البيانات والأصناف" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- ════════ MAIN SPLIT VIEW (CATALOG / CART) ════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="3.8*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT/CENTER: PRODUCT CATALOG ── -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Category Tabs Scroll -->
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding CategoryTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CategoryPillStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#38E07B"/>
                                                    <Setter Property="Foreground" Value="#0F291E"/>
                                                    <Setter Property="BorderBrush" Value="#38E07B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Products Grid Cards -->
                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="10" BorderBrush="#E5E7EB" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="180" Height="115" Style="{StaticResource ProductCardButtonStyle}" 
                                            Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Category Name Badge -->
                                            <Border Grid.Row="0" Background="#F3F4F6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding CategoryName, TargetNullValue='صنف'}" FontSize="10" Foreground="#6B7280"/>
                                            </Border>

                                            <!-- Product Name -->
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" Margin="0,4,0,0" VerticalAlignment="Center"/>

                                            <!-- Price & Code -->
                                            <DockPanel Grid.Row="2" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Code}" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                                <Border Background="#ECFDF5" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding SalePrice, StringFormat={}{0:N2} د.ل}" FontSize="13" FontWeight="Bold" Foreground="#059669"/>
                                                </Border>
                                            </DockPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ── RIGHT: CART / RECEIPT PANEL ── -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="12" Padding="16" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cart Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="تعليق الطلب" Command="{Binding HoldOrderCommand}" Height="28" Padding="10,0" Margin="0,0,4,0" Background="#FEF3C7" Foreground="#92400E" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="تعليق السلة لخدمة عميل آخر"/>
                            <Button Content="استعادة" Command="{Binding RestoreHeldOrderCommand}" Visibility="{Binding HasHeldOrder, Converter={StaticResource BoolToVisibilityConverter}}" Height="28" Padding="10,0" Margin="0,0,4,0" Background="#DBEAFE" Foreground="#1E40AF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="إفراغ" Command="{Binding ClearCartCommand}" Height="28" Padding="10,0" Background="#FEE2E2" Foreground="#991B1B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                        <TextBlock Text="🛒 سلة الفاتورة" FontSize="16" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- Cart Items List -->
                    <Border Grid.Row="1" Background="#F9FAFB" CornerRadius="8" Padding="6" BorderBrush="#E5E7EB" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CartItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFF" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Product Info -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProductName}" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                                    <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N2} د.ل}" FontSize="11" Foreground="#6B7280"/>
                                                </StackPanel>

                                                <!-- Quantity Buttons -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                    <Button Content="-" Command="{Binding DataContext.DecrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="26" Height="26" Background="#F3F4F6" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                                    <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" FontWeight="Bold" Margin="8,0" FontSize="13"/>
                                                    <Button Content="+" Command="{Binding DataContext.IncrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="26" Height="26" Background="#F3F4F6" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                                </StackPanel>

                                                <!-- Total -->
                                                <TextBlock Grid.Column="2" Text="{Binding LineTotal, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center" Margin="8,0" FontSize="13"/>

                                                <!-- Delete -->
                                                <Button Grid.Column="3" Content="✕" Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="24" Height="24" Background="Transparent" Foreground="#EF4444" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Calculations Summary -->
                    <Border Grid.Row="2" Background="#F3F4F6" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="المجموع الفرعي:" Foreground="#4B5563"/>
                                <TextBlock Text="{Binding SubTotal, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="الخصم الكلي:" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding OrderDiscount, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="26" VerticalContentAlignment="Center" Padding="4,0" Background="#FFFFFF" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Separator Margin="0,6" Background="#E5E7EB"/>

                            <!-- Grand Total Box -->
                            <Border Background="#111827" CornerRadius="8" Padding="12,8" Margin="0,4,0,8">
                                <DockPanel>
                                    <TextBlock Text="المطلوب الصافي:" Foreground="#9CA3AF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N2} د.ل}" Foreground="#38E07B" FontWeight="Bold" FontSize="20" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <!-- Payment Method Selector -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="💵 نقداً" IsChecked="True" GroupName="PayMethod" HorizontalAlignment="Center" FontWeight="SemiBold" Checked="PayCash_Checked"/>
                                <RadioButton Grid.Column="1" Content="💳 بطاقة" GroupName="PayMethod" HorizontalAlignment="Center" FontWeight="SemiBold" Checked="PayCard_Checked"/>
                                <RadioButton Grid.Column="2" Content="📑 آجل" GroupName="PayMethod" HorizontalAlignment="Center" FontWeight="SemiBold" Checked="PayCredit_Checked"/>
                            </Grid>

                            <!-- Quick Cash Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <Button Content="التمام" Command="{Binding SetQuickCashCommand}" CommandParameter="0" Height="26" Padding="8,0" Margin="2,0" Background="#E5E7EB" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="10" Command="{Binding SetQuickCashCommand}" CommandParameter="10" Height="26" Padding="8,0" Margin="2,0" Background="#E5E7EB" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="20" Command="{Binding SetQuickCashCommand}" CommandParameter="20" Height="26" Padding="8,0" Margin="2,0" Background="#E5E7EB" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="50" Command="{Binding SetQuickCashCommand}" CommandParameter="50" Height="26" Padding="8,0" Margin="2,0" Background="#E5E7EB" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="100" Command="{Binding SetQuickCashCommand}" CommandParameter="100" Height="26" Padding="8,0" Margin="2,0" Background="#E5E7EB" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="200" Command="{Binding SetQuickCashCommand}" CommandParameter="200" Height="26" Padding="8,0" Margin="2,0" Background="#E5E7EB" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>

                            <!-- Paid & Change -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="المبلغ المستلم (المدفوع):" FontSize="11" Foreground="#4B5563"/>
                                    <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" Padding="6,0" Background="#FFFFFF" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="الباقي للعميل (الفكة):" FontSize="11" Foreground="#4B5563"/>
                                    <Border Background="#FFFFFF" Height="30" CornerRadius="4" BorderBrush="#E5E7EB" BorderThickness="1" Padding="6,0">
                                        <TextBlock Text="{Binding ChangeAmount, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Checkout Button & Status Messages -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button Content="💳 إتمام البيع وحفظ الفاتورة" Command="{Binding SubmitSaleCommand}" Height="46" Background="#38E07B" Foreground="#0F291E" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#059669" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap" HorizontalAlignment="Center" Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap" HorizontalAlignment="Center" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
