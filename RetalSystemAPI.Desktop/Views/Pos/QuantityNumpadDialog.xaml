<Window x:Class="RetalSystemAPI.Desktop.Views.Pos.QuantityNumpadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل الكمية" Height="480" Width="380"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="{DynamicResource SurfaceBrush}" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        KeyDown="Window_KeyDown" Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <Style x:Key="NumpadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Product Name & Unit Price -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtProductName" Text="اسم الصنف" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtUnitPrice" Text="سعر الوحدة: 0.00 د.ل" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="الإجمالي الجديد" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TxtCalculatedTotal" Text="0.00 د.ل" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Quantity Display / Entry Box -->
        <Border Grid.Row="1" Background="{DynamicResource PrimaryLightBrush}" CornerRadius="10" Padding="8" Margin="0,0,0,12" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="-" Click="BtnMinus_Click" Width="42" Height="42" Style="{StaticResource NumpadButtonStyle}" FontSize="22"/>
                <TextBox Grid.Column="1" x:Name="TxtQuantity" Text="1" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkBrush}" TextAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" TextChanged="TxtQuantity_TextChanged"/>
                <Button Grid.Column="2" Content="+" Click="BtnPlus_Click" Width="42" Height="42" Style="{StaticResource NumpadButtonStyle}" FontSize="22"/>
            </Grid>
        </Border>

        <!-- Numpad Grid -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Row 0: 7, 8, 9, Quick 5 -->
            <Button Grid.Row="0" Grid.Column="0" Content="7" Click="BtnDigit_Click" Style="{StaticResource NumpadButtonStyle}"/>
            <Button Grid.Row="0" Grid.Column="1" Content="8" Click="BtnDigit_Click" Style="{StaticResource NumpadButtonStyle}"/>
            <Button Grid.Row="0" Grid.Column="2" Content="9" Click="BtnDigit_Click" Style="{StaticResource NumpadButtonStyle}"/>
            <Button Grid.Row="0" Grid.Column="3" Content="5 قطع" Click="BtnPreset_Click" Tag="5" Style="{StaticResource PresetButtonStyle}"/>

            <!-- Row 1: 4, 5, 6, Quick 10 -->
            <Button Grid.Row="1" Grid.Column="0" Content="4" Click="BtnDigit_Click" Style="{StaticResource NumpadButtonStyle}"/>
            <Button Grid.Row="1" Grid.Column="1" Content="5" Click="BtnDigit_Click" Style="{StaticResource NumpadButtonStyle}"/>
            <Button Grid.Row="1" Grid.Column="2" Content="6" Click="BtnDigit_Click" Style="{StaticResource NumpadButtonStyle}"/>
            <Button Grid.Row="1" Grid.Column="3" Content="10 قطع" Click="BtnPreset_Click" Tag="10" Style="{StaticResource PresetButtonStyle}"/>

            <!-- Row 2: 1, 2, 3, Quick 12 -->
            <Button Grid.Row="2" Grid.Column="0" Content="1" Click="BtnDigit_Click" Style="{StaticResource NumpadButtonStyle}"/>
            <Button Grid.Row="2" Grid.Column="1" Content="2" Click="BtnDigit_Click" Style="{StaticResource NumpadButtonStyle}"/>
            <Button Grid.Row="2" Grid.Column="2" Content="3" Click="BtnDigit_Click" Style="{StaticResource NumpadButtonStyle}"/>
            <Button Grid.Row="2" Grid.Column="3" Content="12 (دستة)" Click="BtnPreset_Click" Tag="12" Style="{StaticResource PresetButtonStyle}"/>

            <!-- Row 3: C (Clear), 0, Backspace, Quick 24 -->
            <Button Grid.Row="3" Grid.Column="0" Content="C" Click="BtnClear_Click" Style="{StaticResource NumpadButtonStyle}" Foreground="{DynamicResource DangerBrush}"/>
            <Button Grid.Row="3" Grid.Column="1" Content="0" Click="BtnDigit_Click" Style="{StaticResource NumpadButtonStyle}"/>
            <Button Grid.Row="3" Grid.Column="2" Content="⌫" Click="BtnBackspace_Click" Style="{StaticResource NumpadButtonStyle}"/>
            <Button Grid.Row="3" Grid.Column="3" Content="24 (صندوق)" Click="BtnPreset_Click" Tag="24" Style="{StaticResource PresetButtonStyle}"/>
        </Grid>

        <!-- Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="تأكيد الكمية (Enter)" Click="BtnConfirm_Click" Style="{StaticResource PrimaryButtonStyle}" Height="40" Margin="0,0,4,0" FontWeight="Bold"/>
            <Button Grid.Column="1" Content="إلغاء (Esc)" Click="BtnCancel_Click" Style="{StaticResource GhostButtonStyle}" Height="40" Margin="4,0,0,0"/>
        </Grid>
    </Grid>
</Window>
