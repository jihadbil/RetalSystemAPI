<Window x:Class="RetalSystemAPI.Desktop.Views.Catalog.Dialogs.ProductImportWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ModernDialogWindowStyle}"
        AllowsTransparency="True" WindowStartupLocation="CenterOwner"
        Title="معالج استيراد الأصناف من Excel" Height="680" Width="880" Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Style="{StaticResource DialogCardBorderStyle}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Dialog Header -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="معالج استيراد وفحص الأصناف من Excel" Style="{StaticResource H2TextBlockStyle}" FontSize="17" />
                    <TextBlock Text="استيراد وتحديث المنتجات والباركودات والتصنيفات والوحدات وتهيئة أرصدة المخازن" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource DialogCloseButtonStyle}" Click="Cancel_Click" VerticalAlignment="Top" />
            </Grid>

            <!-- Stepper Progress Header -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Step 1 Indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource PrimaryBrush}" Margin="0,0,8,0">
                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                        </Border>
                        <TextBlock Text="الملف والإعدادات" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="←" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0" />

                    <!-- Step 2 Indicator -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,8,0"
                                Background="{Binding CurrentStep, Converter={StaticResource StepNumberToBrushConverter}, ConverterParameter=2}">
                            <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                        </Border>
                        <TextBlock Text="الفحص والمعاينة" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="←" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0" />

                    <!-- Step 3 Indicator -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,8,0"
                                Background="{Binding CurrentStep, Converter={StaticResource StepNumberToBrushConverter}, ConverterParameter=3}">
                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                        </Border>
                        <TextBlock Text="جاري التنفيذ" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                    </StackPanel>

                    <TextBlock Grid.Column="5" Text="←" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0" />

                    <!-- Step 4 Indicator -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,8,0"
                                Background="{Binding CurrentStep, Converter={StaticResource StepNumberToBrushConverter}, ConverterParameter=4}">
                            <TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                        </Border>
                        <TextBlock Text="النتائج والملخص" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area (Steps 1 to 4) -->
            <Grid Grid.Row="2" Margin="0,0,0,16">

                <!-- STEP 1: File Selection & Options -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}">
                    <StackPanel>
                        <!-- File Selector Card -->
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📁 اختيار ملف Excel" Style="{StaticResource H2TextBlockStyle}" FontSize="15" Margin="0,0,0,10" />
                                <TextBlock Text="يدعم النظام استيراد ملفات Excel بصيغة ورقة واحدة مسطحة (الأسهل والأشمل) أو بصيغة 3 أوراق عمل (الأصناف، الباركودات، التصنيفات)." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{Binding SelectedFilePath, Mode=TwoWay, ValidatesOnExceptions=True}" IsReadOnly="True" Style="{StaticResource DefaultTextBoxStyle}" VerticalContentAlignment="Center" FontSize="13" />
                                    <Button Grid.Column="2" Content="تصفح واختيار ملف..." Style="{StaticResource PrimaryButtonStyle}" Command="{Binding BrowseFileCommand}" Width="160" Height="38" />
                                </Grid>

                                <!-- Template Downloads -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <TextBlock Text="هل تحتاج قالباً جاهزاً؟" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Content="📥 تنزيل القالب البسيط (شيت واحد)" Style="{StaticResource GhostButtonStyle}" Command="{Binding DownloadTemplateSingleCommand}" Margin="0,0,8,0" />
                                    <Button Content="📥 تنزيل القالب المتقدم (3 شيتات)" Style="{StaticResource GhostButtonStyle}" Command="{Binding DownloadTemplateMultiCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Import Settings Card -->
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="⚙️ إعدادات وخيارات الاستيراد" Style="{StaticResource H2TextBlockStyle}" FontSize="15" Margin="0,0,0,14" />

                                <!-- Strategy Selection -->
                                <TextBlock Text="استراتيجية الاستيراد:" Style="{StaticResource FormLabelStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                    <RadioButton Content="تحديث وإضافة (Upsert - إضافة الجديد وتحديث المسجل مسبقاً)" IsChecked="True" GroupName="ImportStrategy" Margin="0,0,20,0" FontSize="13" />
                                    <RadioButton Content="إضافة الجديد فقط (تجاهل المسجل)" GroupName="ImportStrategy" Margin="0,0,20,0" FontSize="13" />
                                    <RadioButton Content="تحديث الأسعار والمخزون فقط" GroupName="ImportStrategy" FontSize="13" />
                                </StackPanel>

                                <!-- Warehouses Selection -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="صالة العرض الافتراضية لتهيئة الرصيد" Style="{StaticResource FormLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding AvailableShowroomWarehouses}"
                                                  SelectedValue="{Binding SelectedShowroomWarehouseId, Mode=TwoWay}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource DefaultComboBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="مخزن التخزين الافتراضي لتهيئة الباركودات" Style="{StaticResource FormLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding AvailableStorageWarehouses}"
                                                  SelectedValue="{Binding SelectedStorageWarehouseId, Mode=TwoWay}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource DefaultComboBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Auto-create Options -->
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <CheckBox Content="إنشاء التصنيفات الجديدة تلقائياً عند عدم وجودها" IsChecked="{Binding AutoCreateCategories, Mode=TwoWay}" Margin="0,0,24,0" FontSize="13" />
                                        <CheckBox Content="إنشاء الوحدات الجديدة تلقائياً عند عدم وجودها" IsChecked="{Binding AutoCreateUnits, Mode=TwoWay}" FontSize="13" />
                                    </StackPanel>
                                    <CheckBox Content="صرف وتوليد باركودات تسلسلية فريدة تلقائياً للأصناف التي ليس لها كود" IsChecked="{Binding AutoGenerateMissingBarcodes, Mode=TwoWay}" FontSize="13" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- STEP 2: Validation Preview & KPI Summary -->
                <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- KPI Statistics Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Total Card -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="all" />
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="إجمالي الصفوف" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{Binding ValidationResult.TotalRows, FallbackValue=0}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Valid Card -->
                        <Border Grid.Column="2" Background="{DynamicResource SuccessLightBrush}" BorderBrush="{DynamicResource SuccessLightBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="صفوف صالحة" Foreground="{DynamicResource SuccessBrush}" FontSize="11" />
                                <TextBlock Text="{Binding ValidationResult.ValidRows, FallbackValue=0}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- New Items Card -->
                        <Border Grid.Column="4" Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource AccentLightBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="new" />
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="أصناف جديدة" Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                                <TextBlock Text="{Binding ValidationResult.NewProductsCount, FallbackValue=0}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Updates Card -->
                        <Border Grid.Column="6" Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource AccentLightBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="updates" />
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="تحديث بيانات" Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                                <TextBlock Text="{Binding ValidationResult.UpdatedProductsCount, FallbackValue=0}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Missing/Auto Barcode Card -->
                        <Border Grid.Column="8" Background="{DynamicResource WarningLightBrush}" BorderBrush="{DynamicResource WarningLightBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="no_barcode" />
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="بدون كود (صرف تلقائي)" Foreground="{DynamicResource WarningBrush}" FontSize="11" />
                                <TextBlock Text="{Binding ValidationResult.AutoGeneratedBarcodesCount, FallbackValue=0}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Errors Card -->
                        <Border Grid.Column="10" Background="{DynamicResource DangerLightBrush}" BorderBrush="{DynamicResource DangerLightBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="errors" />
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="أخطاء وتنبيهات" Foreground="{DynamicResource DangerBrush}" FontSize="11" />
                                <TextBlock Text="{Binding ValidationResult.InvalidRows, FallbackValue=0}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Filter Buttons Bar -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="تصفية العرض:" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="الكل" Style="{StaticResource GhostButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="all" Margin="0,0,6,0" Padding="10,4" />
                        <Button Content="✨ أصناف جديدة" Style="{StaticResource GhostButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="new" Margin="0,0,6,0" Padding="10,4" />
                        <Button Content="🔄 تحديثات" Style="{StaticResource GhostButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="updates" Margin="0,0,6,0" Padding="10,4" />
                        <Button Content="🏷️ بدون كود / صرف تلقائي" Style="{StaticResource GhostButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="no_barcode" Margin="0,0,6,0" Padding="10,4" Background="{DynamicResource WarningLightBrush}" />
                        <Button Content="⚠️ تنبيهات" Style="{StaticResource GhostButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="warnings" Margin="0,0,6,0" Padding="10,4" />
                        <Button Content="❌ أخطاء فقط" Style="{StaticResource GhostButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="errors" Padding="10,4" />
                    </StackPanel>

                    <!-- Manual Barcode Assignment Toolbar -->
                    <Border Grid.Row="2" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Label and Selected Item Name -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="🛠️ صرف وتعديل الباركود:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding SelectedRow.Name, FallbackValue='(حدد صنفاً من الجدول)'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Center: Manual Barcode Input & Assign Button -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Width="170" Text="{Binding ManualBarcodeEntry, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource DefaultTextBoxStyle}" Height="30" Margin="0,0,6,0" VerticalContentAlignment="Center" FontSize="12" Tag="اكتب أو امسح الباركود..." />
                                <Button Content="📌 تعيين الكود للصنف" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AssignManualBarcodeCommand}" Padding="10,4" Height="30" Margin="0,0,6,0" FontSize="12" />
                                <Button Content="⚡ توليد كود تسلسلي" Style="{StaticResource GhostButtonStyle}" Command="{Binding GenerateSequenceBarcodeCommand}" Padding="8,4" Height="30" Margin="0,0,6,0" FontSize="12" />
                                <Button Content="🗑️ مسح الكود" Style="{StaticResource GhostButtonStyle}" Command="{Binding ClearBarcodeForRowCommand}" Padding="8,4" Height="30" FontSize="12" />
                            </StackPanel>

                            <!-- Right: Bulk Action Button -->
                            <Button Grid.Column="2" Content="✨ صرف أكواد تسلسلية لجميع الأصناف الفارغة" Style="{StaticResource GhostButtonStyle}" Command="{Binding AutoGenerateAllMissingBarcodesCommand}" Padding="12,4" Height="30" Foreground="{DynamicResource SuccessBrush}" Background="{DynamicResource SuccessLightBrush}" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <!-- Preview DataGrid -->
                    <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredValidationRows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              Background="{DynamicResource SurfaceBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" IsReadOnly="True" Width="40" />
                            <DataGridTemplateColumn Header="الإجراء" IsReadOnly="True" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center"
                                                Background="{Binding ActionBadgeColor}">
                                            <TextBlock Text="{Binding ActionText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="كود الصنف" Binding="{Binding ItemCode}" IsReadOnly="True" Width="80" />
                            <DataGridTextColumn Header="اسم الصنف" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                            <DataGridTemplateColumn Header="الباركود" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="3" Padding="4,1" Margin="0,0,4,0" Background="{Binding BarcodeDisplayBadgeColor}">
                                                <TextBlock Text="{Binding BarcodeTypeBadgeText}" Foreground="White" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="{Binding BarCode}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" FontSize="12" Padding="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="التصنيف" Binding="{Binding CategoryName}" IsReadOnly="True" Width="95" />
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" IsReadOnly="True" Width="60" />
                            <DataGridTextColumn Header="التكلفة" Binding="{Binding CostPrice, StringFormat=N2}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="سعر البيع" Binding="{Binding SalePrice, StringFormat=N2}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="كمية الصالة" Binding="{Binding ShowroomQuantity}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="كمية المخزن" Binding="{Binding StorageQuantity}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="ملاحظات وفحص السطر" Binding="{Binding Message}" IsReadOnly="True" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- STEP 3: Execution Progress -->
                <Border Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=3}"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="40" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="500">
                        <TextBlock Text="⚡ جاري استيراد وحفظ البيانات..." Style="{StaticResource H2TextBlockStyle}" HorizontalAlignment="Center" FontSize="18" Margin="0,0,0,16" />
                        <ProgressBar Value="{Binding ExecutionProgress}" Maximum="100" Height="14" Margin="0,0,0,14" />
                        <TextBlock Text="{Binding ExecutionStatusText}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Border>

                <!-- STEP 4: Results & Summary -->
                <Border Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=4}"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="30">
                    <StackPanel>
                        <!-- Success Banner -->
                        <Border Background="{DynamicResource SuccessLightBrush}" BorderBrush="{DynamicResource SuccessLightBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎉" FontSize="36" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="اكتملت عملية الاستيراد بنجاح!" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource SuccessBrush}" />
                                    <TextBlock Text="تم تحديث وحفظ كافة السجلات المطابقة بنجاح في قاعدة البيانات." Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Metrics Grid -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="الأصناف المعالجة" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{Binding ImportResult.ProductsImported, FallbackValue=0}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="إجمالي الباركودات" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{Binding ImportResult.BarcodesImported, FallbackValue=0}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="أكواد مصروفة تلقائياً" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{Binding ImportResult.AutoGeneratedBarcodesCount, FallbackValue=0}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="6" Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="التصنيفات والوحدات" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{Binding ImportResult.CategoriesImported, FallbackValue=0}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Rejected Rows Warning Bar (If Any) -->
                        <Border Background="{DynamicResource DangerLightBrush}" BorderBrush="{DynamicResource DangerLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20"
                                Visibility="{Binding ImportResult.FailedRowsCount, Converter={StaticResource NumberToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="تنبيه: توجد أسطر لم يتم استيرادها بسبب عدم توافق البيانات" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                                    <TextBlock Text="يمكنك تصدير هذه الأسطر إلى ملف Excel يحتوي على سبب الرفض لتصحيحها وإعادة رفعها بسهولة." Style="{StaticResource CaptionTextBlockStyle}" Margin="0,2,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="📥 تصدير الأسطر المرفوضة..." Style="{StaticResource PrimaryButtonStyle}"
                                        Background="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerHoverBrush}" Command="{Binding ExportFailedRowsCommand}" Padding="16,6" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- Dialog Footer Bar -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Previous Step Button -->
                <Button Grid.Column="0" Content="السابق" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding GoToStepCommand}" CommandParameter="1"
                        Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}"
                        Width="100" />

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Step 1 Next Button -->
                    <Button Content="فحص ومعاينة البيانات ←" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding RunValidationCommand}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}"
                            Width="180" Margin="6,0,0,0" />

                    <!-- Step 2 Import Button -->
                    <Button Content="بدء الاستيراد الفعلي 🚀" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ExecuteImportCommand}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}"
                            Width="180" Margin="6,0,0,0" />

                    <!-- Step 4 Close Button -->
                    <Button Content="إغلاق وإنهاء" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CloseCommand}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=4}"
                            Width="140" Margin="6,0,0,0" />

                    <!-- Cancel Button for Steps 1 and 2 -->
                    <Button Content="إلغاء" Style="{StaticResource GhostButtonStyle}" Click="Cancel_Click"
                            Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1_2}"
                            Width="90" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
