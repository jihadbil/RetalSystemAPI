<UserControl x:Class="RetalSystemAPI.Desktop.Views.Catalog.UnitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RetalSystemAPI.Desktop.Controls"
             FlowDirection="RightToLeft">
    <Grid Margin="24" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <TextBlock Text="وحدات القياس" Style="{StaticResource H1TextBlockStyle}" VerticalAlignment="Center" />
            <Button Content="+ إضافة وحدة قياس" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateUnitCommand}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
        </DockPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Units}" Style="{StaticResource DefaultDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="اسم الوحدة" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="الرمز / الاختصار" Binding="{Binding Symbol}" Width="*" />
                <DataGridTemplateColumn Header="الإجراءات" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="تعديل" Style="{StaticResource GhostButtonStyle}" Command="{Binding DataContext.EditUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" FontSize="12" />
                                <Button Content="حذف" Style="{StaticResource DangerButtonStyle}" Command="{Binding DataContext.DeleteUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <controls:LoadingOverlay Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>
