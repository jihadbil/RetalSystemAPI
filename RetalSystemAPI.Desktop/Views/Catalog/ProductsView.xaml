<UserControl x:Class="RetalSystemAPI.Desktop.Views.Catalog.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RetalSystemAPI.Desktop.Controls"
             FlowDirection="RightToLeft">
    <Grid Margin="24" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,16">
            <TextBlock Text="إدارة المنتجات" Style="{StaticResource H1TextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="📥 تنزيل القالب" Style="{StaticResource GhostButtonStyle}" Command="{Binding DownloadTemplateCommand}" Margin="0,0,8,0" />
                <Button Content="📊 استيراد Excel" Style="{StaticResource GhostButtonStyle}" Command="{Binding ImportExcelCommand}" Margin="0,0,8,0" />
                <Button Content="📤 تصدير Excel" Style="{StaticResource GhostButtonStyle}" Command="{Binding ExportExcelCommand}" Margin="0,0,8,0" />
                <Button Content="+ إضافة منتج جديد" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateProductCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Search Bar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DefaultTextBoxStyle}" Width="300" HorizontalAlignment="Right" DockPanel.Dock="Left" />
            <Button Content="بحث" Style="{StaticResource GhostButtonStyle}" Command="{Binding LoadProductsCommand}" Margin="8,0,0,0" HorizontalAlignment="Right" />
        </DockPanel>

        <!-- Data Grid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Products}" Style="{StaticResource DefaultDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="كود المنتج" Binding="{Binding Code}" Width="120" />
                <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="التصنيف" Binding="{Binding CategoryName}" Width="*" />
                <DataGridTextColumn Header="سعر التكلفة" Binding="{Binding CostPrice, StringFormat={}{0:N2}}" Width="110" />
                <DataGridTextColumn Header="سعر البيع" Binding="{Binding SalePrice, StringFormat={}{0:N2}}" Width="110" />
                <DataGridTemplateColumn Header="الإجراءات" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="تعديل" Style="{StaticResource GhostButtonStyle}" Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" FontSize="12" />
                                <Button Content="حذف" Style="{StaticResource DangerButtonStyle}" Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Pagination -->
        <controls:PaginationControl Grid.Row="3" CurrentPage="{Binding CurrentPage}" TotalPages="{Binding TotalPages}" PageSize="{Binding PageSize, Mode=TwoWay}" IsLoading="{Binding IsLoading}" NextPageCommand="{Binding NextPageCommand}" PrevPageCommand="{Binding PrevPageCommand}" />

        <controls:LoadingOverlay Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>
