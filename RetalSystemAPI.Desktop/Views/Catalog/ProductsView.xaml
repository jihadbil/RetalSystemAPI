<UserControl x:Class="RetalSystemAPI.Desktop.Views.Catalog.ProductsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:RetalSystemAPI.Desktop.Controls" xmlns:helpers="clr-namespace:RetalSystemAPI.Desktop.Helpers"
 FlowDirection="RightToLeft" Foreground="{DynamicResource TextPrimaryBrush}">
 <Grid Margin="20,16" Background="{DynamicResource BackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,16">
   <StackPanel Margin="0,0,28,10"><TextBlock Text="المنتجات والأصناف" Style="{StaticResource H1TextBlockStyle}"/><TextBlock Text="الأسعار والباركودات والتصنيفات في مكان واحد" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel>
   <Button Content="+ إضافة منتج" Command="{Binding CreateProductCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Margin="0,0,8,8"/>
   <Expander Header="استيراد وتصدير" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8">
    <WrapPanel Margin="0,8,0,0"><Button Content="استيراد Excel" Command="{Binding ImportExcelCommand}" Margin="0,0,6,4"/><Button Content="تصدير Excel" Command="{Binding ExportExcelCommand}" Margin="0,0,6,4"/><Button Content="تنزيل القالب" Command="{Binding DownloadTemplateCommand}" Margin="0,0,0,4"/></WrapPanel>
   </Expander>
  </WrapPanel>
  <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0">
     <TextBlock Text="البحث عن منتج" FontSize="13" Margin="0,0,0,6"/>
     <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Height="38" AutomationProperties.Name="البحث عن منتج" ToolTip="اكتب الاسم أو الكود أو الباركود ثم اضغط Enter">
      <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
     </TextBox>
    </StackPanel>
    <CheckBox Grid.Column="1" Content="مطابقة الباركود تماماً" IsChecked="{Binding ExactBarcodeMatch}" VerticalAlignment="Bottom" Margin="0,0,8,12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="يقتصر البحث على التطابق التام مع رقم الباركود"/>
    <Button Grid.Column="2" Content="بحث" Command="{Binding SearchCommand}" VerticalAlignment="Bottom" Height="38" Margin="0,0,8,0"/>
    <Button Grid.Column="3" Content="مسح البحث" Command="{Binding ClearSearchCommand}" VerticalAlignment="Bottom" Height="38"/>
   </Grid>
  </Border>
  <Border Grid.Row="2" Padding="12" CornerRadius="8" Background="{DynamicResource DangerLightBrush}" Margin="0,0,0,10" Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
   <DockPanel><Button Content="إعادة المحاولة" Command="{Binding LoadProductsCommand}" DockPanel.Dock="Left" Margin="12,0,0,0"/><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"/></DockPanel>
  </Border>
  <Grid Grid.Row="3">
   <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <DataGrid ItemsSource="{Binding Products}" Style="{StaticResource DefaultDataGridStyle}" SelectionMode="Single" MinRowHeight="50" AutomationProperties.Name="قائمة المنتجات">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="" Width="64" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate>
      <Border Width="36" Height="36" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6">
       <Grid><Path Data="{StaticResource IconProducts}" Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource TextMutedBrush}"/><Image helpers:ImageHelper.SourceUrl="{Binding DefaultImage}" Stretch="Uniform" Width="36" Height="36"/></Grid>
      </Border>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="2*" MinWidth="150"/>
     <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="110"/>
     <DataGridTextColumn Header="التصنيف" Binding="{Binding CategoryName}" Width="*" MinWidth="100"/>
     <DataGridTextColumn Header="التكلفة" Binding="{Binding CostPrice, StringFormat={}{0:N2}}" Width="95"/>
     <DataGridTextColumn Header="البيع · د.ل" Binding="{Binding SalePrice, StringFormat={}{0:N2}}" Width="100"/>
     <DataGridTemplateColumn Header="الإجراءات" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate>
      <StackPanel Orientation="Horizontal">
       <Button Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource TextPrimaryBrush}" Content="تعديل" Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,5" Margin="0,0,6,0"/>
       <Button Content="حذف" Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource TextButtonStyle}" Foreground="{DynamicResource DangerBrush}" Padding="6,5"/>
      </StackPanel>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <controls:EmptyStateControl Title="{Binding EmptyTitle}" Description="{Binding EmptyDescription}" ActionText="+ إضافة منتج" ActionCommand="{Binding CreateProductCommand}" IconData="{StaticResource IconProducts}">
    <controls:EmptyStateControl.Style><Style TargetType="controls:EmptyStateControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Products.Count}" Value="0"/><Condition Binding="{Binding IsLoading}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></controls:EmptyStateControl.Style>
   </controls:EmptyStateControl>
  </Grid>
  <StackPanel Grid.Row="4">
   <TextBlock Text="{Binding TotalCount, StringFormat=عدد النتائج: {0}}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"/>
   <controls:PaginationControl CurrentPage="{Binding CurrentPage}" TotalPages="{Binding TotalPages}" PageSize="{Binding PageSize, Mode=TwoWay}" IsLoading="{Binding IsLoading}" NextPageCommand="{Binding NextPageCommand}" PrevPageCommand="{Binding PrevPageCommand}"/>
  </StackPanel>
  <controls:LoadingOverlay Grid.RowSpan="5" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
 </Grid>
</UserControl>