<Window x:Class="RetalSystemAPI.Desktop.Views.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emerald Management Pro" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Margin="20">
                    <TextBlock Text="Emerald Pro" Style="{StaticResource H1TextBlockStyle}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="نظام إدارة المقاهي" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Navigation Links -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8">
                        <Button Content="⚡ نقطة البيع (POS)" Command="{Binding NavigateToPosCommand}" HorizontalContentAlignment="Right" Margin="0,2,0,8" Padding="12,10" Background="#38E07B" Foreground="#0F291E" FontWeight="Bold" BorderThickness="0" Cursor="Hand" />
                        <Button Content="الرئيسية" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToDashboardCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="الملف الشخصي" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToTenantsCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="🏢 الفروع" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToBranchesCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="🗂️ التصنيفات" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToCategoriesCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="📏 وحدات القياس" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToUnitsCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="☕ المنتجات" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToProductsCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="👥 العملاء والحسابات" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToCustomersCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="🧾 فواتير المبيعات" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToSalesInvoicesCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="🔄 مرتجعات المبيعات" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToSalesReturnsCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="🤝 الموردين" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToSuppliersCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="🏪 المخازن والصالات" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToWarehousesCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="📦 إدارة المخزون" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToStockCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="🚚 التحويلات المخزنية" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToStockTransfersCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="⚖️ التسويات الجردية" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToStockAdjustmentsCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="📝 طلبيات الشراء" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToPurchaseOrdersCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="📥 فواتير المشتريات" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToPurchaseInvoicesCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                        <Button Content="👤 إدارة المستخدمين" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToUsersCommand}" HorizontalContentAlignment="Right" Margin="0,3" Padding="12,8" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Logout -->
                <Border Grid.Row="2" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Button Content="تسجيل الخروج" Style="{StaticResource DangerButtonStyle}" Command="{Binding LogoutCommand}" HorizontalAlignment="Stretch" />
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Title Bar -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource H2TextBlockStyle}" />
            </Border>

            <!-- View Presenter -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>
