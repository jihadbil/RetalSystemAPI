<Window x:Class="RetalSystemAPI.Desktop.Views.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emerald Management Pro" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Margin="20">
                    <TextBlock Text="Emerald Pro" Style="{StaticResource H1TextBlockStyle}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="نظام إدارة المقاهي" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1" Margin="12,12">
                    <Button Content="الرئيسية" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToDashboardCommand}" HorizontalContentAlignment="Right" Margin="0,4" Padding="12,10" />
                    <Button Content="الملف الشخصي" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToTenantsCommand}" HorizontalContentAlignment="Right" Margin="0,4" Padding="12,10" />
                    <Button Content="الفروع" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToBranchesCommand}" HorizontalContentAlignment="Right" Margin="0,4" Padding="12,10" />
                    <Button Content="التصنيفات" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToCategoriesCommand}" HorizontalContentAlignment="Right" Margin="0,4" Padding="12,10" />
                    <Button Content="وحدات القياس" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToUnitsCommand}" HorizontalContentAlignment="Right" Margin="0,4" Padding="12,10" />
                    <Button Content="المنتجات" Style="{StaticResource GhostButtonStyle}" Command="{Binding NavigateToProductsCommand}" HorizontalContentAlignment="Right" Margin="0,4" Padding="12,10" />
                </StackPanel>

                <!-- Footer Logout -->
                <Border Grid.Row="2" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Button Content="تسجيل الخروج" Style="{StaticResource DangerButtonStyle}" Command="{Binding LogoutCommand}" HorizontalAlignment="Stretch" />
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Title Bar -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource H2TextBlockStyle}" />
            </Border>

            <!-- View Presenter -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>
