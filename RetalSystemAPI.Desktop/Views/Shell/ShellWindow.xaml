<Window x:Class="RetalSystemAPI.Desktop.Views.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RetalSystemAPI.Desktop.Controls"
        Title="Emerald Management Pro - نظام إدارة المبيعات والمخازن" 
        Height="820" Width="1360" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FlowDirection="RightToLeft" Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <!-- Modern Sidebar Nav Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,3.5,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Padding" Value="4,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Sidebar Expander Style -->
        <Style x:Key="SidebarExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,2,0,4" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <StackPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Cursor="Hand"
                                              FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="headerBorder" 
                                                    Background="{DynamicResource SurfaceHoverBrush}" 
                                                    BorderBrush="{DynamicResource BorderBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="10,7" 
                                                    Margin="0,1">
                                                <DockPanel LastChildFill="True">
                                                    <!-- Smooth Vector Chevron -->
                                                    <Path x:Name="arrow" 
                                                          Data="{StaticResource IconChevron}" 
                                                          Fill="{DynamicResource TextMutedBrush}" 
                                                          Width="8" Height="8" 
                                                          Stretch="Uniform" 
                                                          DockPanel.Dock="Left" 
                                                          VerticalAlignment="Center" 
                                                          Margin="4,0,0,0"
                                                          RenderTransformOrigin="0.5,0.5"
                                                          Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="180" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="False">
                                                    <Setter TargetName="headerBorder" Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="headerBorder" Property="Background" Value="Transparent" />
                                                    <Setter TargetName="headerBorder" Property="BorderBrush" Value="Transparent" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="270" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter Content="{TemplateBinding Header}" />
                                </ToggleButton>

                                <!-- Sub-items container with visual nesting tree guide line -->
                                <Border x:Name="ExpandSite" Visibility="Collapsed" 
                                        Padding="4,2,0,2" 
                                        Margin="4,2,2,4"
                                        BorderThickness="0,0,2,0" 
                                        BorderBrush="{DynamicResource BorderBrush}">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Margin" Value="0,2,0,2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExpanderHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Visibility" Value="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
        </Style>

        <Style x:Key="SidebarItemTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Visibility" Value="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
        </Style>

        <Style x:Key="SidebarIconStyle" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ════════════ SIDEBAR NAVIGATION ════════════ -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Border Grid.Row="0" Padding="12,16" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <DockPanel HorizontalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBrand}" Fill="{DynamicResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0"
                                    Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="Emerald Pro" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFontFamily}" />
                            <TextBlock Text="نظام الإدارة والمبيعات" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource AppFontFamily}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Navigation Accordion -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,10">
                    <StackPanel>
                        
                                <!-- Dashboard -->
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessDashboard, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=Dashboard}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=Dashboard}"
                                        Command="{Binding NavigateToDashboardCommand}"
                                        ToolTip="لوحة التحكم">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconDashboard}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="لوحة التحكم" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=Dashboard}" />
                                    </DockPanel>
                                </Button>

                                <!-- Hero Action: Quick POS -->
                                <Button Command="{Binding NavigateToPosCommand}" 
                                        Visibility="{Binding CanAccessPos, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="2,4,2,12" Padding="10,9" 
                                        Background="{DynamicResource PrimaryBrush}" 
                                        Foreground="{DynamicResource PrimaryOnBrush}" 
                                        BorderThickness="0" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch"
                                        ToolTip="نقطة البيع السريعة (POS)">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10" />
                                        </Style>
                                    </Button.Resources>
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconPos}" Fill="{DynamicResource PrimaryOnBrush}" Width="16" Height="16" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="نقطة البيع السريعة (POS)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryOnBrush}" />
                                    </DockPanel>
                                </Button>

                        <!-- Group 1: المبيعات والعملاء -->
                        <Expander Style="{StaticResource SidebarExpanderStyle}" IsExpanded="False" Visibility="{Binding CanAccessSalesGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Expander.Header>
                                <DockPanel HorizontalAlignment="Center">
                                    <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconSales}" Fill="{DynamicResource PrimaryBrush}" Width="14" Height="14" />
                                    <TextBlock Text="المبيعات والعملاء" Style="{StaticResource ExpanderHeaderTextStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>

                                <!-- Sales Invoices -->
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessSalesInvoices, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=SalesInvoices}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=SalesInvoices}"
                                        Command="{Binding NavigateToSalesInvoicesCommand}"
                                        ToolTip="فواتير المبيعات">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconInvoices}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="فواتير المبيعات" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=SalesInvoices}" />
                                    </DockPanel>
                                </Button>

                                <!-- Sales Returns -->
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessSalesReturns, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=SalesReturns}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=SalesReturns}"
                                        Command="{Binding NavigateToSalesReturnsCommand}"
                                        ToolTip="مرتجعات المبيعات">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconReturns}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="مرتجعات المبيعات" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=SalesReturns}" />
                                    </DockPanel>
                                </Button>

                                <!-- Customers -->
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessCustomers, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=Customers}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=Customers}"
                                        Command="{Binding NavigateToCustomersCommand}"
                                        ToolTip="العملاء والحسابات">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconCustomers}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="العملاء والحسابات" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=Customers}" />
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <!-- Group 2: المشتريات والموردين -->
                        <Expander Style="{StaticResource SidebarExpanderStyle}" IsExpanded="False" Visibility="{Binding CanAccessPurchaseGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Expander.Header>
                                <DockPanel HorizontalAlignment="Center">
                                    <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconPurchases}" Fill="{DynamicResource PrimaryBrush}" Width="14" Height="14" />
                                    <TextBlock Text="المشتريات والموردين" Style="{StaticResource ExpanderHeaderTextStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessPurchaseInvoices, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=PurchaseInvoices}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=PurchaseInvoices}"
                                        Command="{Binding NavigateToPurchaseInvoicesCommand}"
                                        ToolTip="فواتير المشتريات">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconPurchases}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="فواتير المشتريات" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=PurchaseInvoices}" />
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessPurchaseReturns, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=PurchaseReturns}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=PurchaseReturns}"
                                        Command="{Binding NavigateToPurchaseReturnsCommand}"
                                        ToolTip="مرتجعات المشتريات">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconReturns}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="مرتجعات المشتريات" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=PurchaseReturns}" />
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessPurchaseOrders, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=PurchaseOrders}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=PurchaseOrders}"
                                        Command="{Binding NavigateToPurchaseOrdersCommand}"
                                        ToolTip="طلبيات الشراء">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconPurchaseOrders}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="طلبيات الشراء" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=PurchaseOrders}" />
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessSuppliers, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=Suppliers}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=Suppliers}"
                                        Command="{Binding NavigateToSuppliersCommand}"
                                        ToolTip="الموردين">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconSuppliers}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="الموردين" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=Suppliers}" />
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <!-- Group 3: المخزون والأصناف -->
                        <Expander Style="{StaticResource SidebarExpanderStyle}" IsExpanded="False" Visibility="{Binding CanAccessStockGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Expander.Header>
                                <DockPanel HorizontalAlignment="Center">
                                    <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconStock}" Fill="{DynamicResource PrimaryBrush}" Width="14" Height="14" />
                                    <TextBlock Text="المخزون والأصناف" Style="{StaticResource ExpanderHeaderTextStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessStock, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=Stock}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=Stock}"
                                        Command="{Binding NavigateToStockCommand}"
                                        ToolTip="إدارة المخزون والأرصدة">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconStock}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="إدارة المخزون والأرصدة" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=Stock}" />
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessProducts, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=Products}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=Products}"
                                        Command="{Binding NavigateToProductsCommand}"
                                        ToolTip="المنتجات والأصناف">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconProducts}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="المنتجات والأصناف" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=Products}" />
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessCategories, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=Categories}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=Categories}"
                                        Command="{Binding NavigateToCategoriesCommand}"
                                        ToolTip="التصنيفات">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconCategories}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="التصنيفات" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=Categories}" />
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessUnits, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=Units}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=Units}"
                                        Command="{Binding NavigateToUnitsCommand}"
                                        ToolTip="وحدات القياس">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconUnits}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="وحدات القياس" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=Units}" />
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessWarehouses, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=Warehouses}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=Warehouses}"
                                        Command="{Binding NavigateToWarehousesCommand}"
                                        ToolTip="المخازن وصالات العرض">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconWarehouses}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="المخازن وصالات العرض" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=Warehouses}" />
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessStockTransfers, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=StockTransfers}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=StockTransfers}"
                                        Command="{Binding NavigateToStockTransfersCommand}"
                                        ToolTip="التحويلات المخزنية">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconTransfers}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="التحويلات المخزنية" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=StockTransfers}" />
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessStockAdjustments, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=StockAdjustments}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=StockAdjustments}"
                                        Command="{Binding NavigateToStockAdjustmentsCommand}"
                                        ToolTip="التسويات الجردية">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconAdjustments}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="التسويات الجردية" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=StockAdjustments}" />
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <!-- Group 4: الإدارة والنظام -->
                        <Expander Style="{StaticResource SidebarExpanderStyle}" IsExpanded="False" Visibility="{Binding CanAccessAdminGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Expander.Header>
                                <DockPanel HorizontalAlignment="Center">
                                    <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconSettings}" Fill="{DynamicResource PrimaryBrush}" Width="14" Height="14" />
                                    <TextBlock Text="الإدارة والنظام" Style="{StaticResource ExpanderHeaderTextStyle}"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessBranches, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=Branches}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=Branches}"
                                        Command="{Binding NavigateToBranchesCommand}"
                                        ToolTip="الفروع">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconBranches}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="الفروع" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=Branches}" />
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessUsers, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=Users}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=Users}"
                                        Command="{Binding NavigateToUsersCommand}"
                                        ToolTip="إدارة المستخدمين">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconUsers}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="إدارة المستخدمين والصلاحيات" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=Users}" />
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                        Visibility="{Binding CanAccessTenants, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{Binding ActiveSection, Converter={StaticResource ActiveNavToBrushConverter}, ConverterParameter=Tenants}"
                                        BorderBrush="{Binding ActiveSection, Converter={StaticResource ActiveNavToBorderBrushConverter}, ConverterParameter=Tenants}"
                                        Command="{Binding NavigateToTenantsCommand}"
                                        ToolTip="الملف الشخصي للمؤسسة">
                                    <DockPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconTenants}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" />
                                        <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="الملف الشخصي للمؤسسة" Foreground="{Binding ActiveSection, Converter={StaticResource ActiveNavToForegroundConverter}, ConverterParameter=Tenants}" />
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Logout -->
                <Border Grid.Row="2" Padding="10,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SurfaceHoverBrush}">
                    <StackPanel>
                        <!-- User Status Pill -->
                        <Border Background="{DynamicResource CardBgBrush}" 
                                BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="8,6" 
                                Margin="0,0,0,8"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <DockPanel>
                                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding CurrentUserDisplay}" 
                                           FontSize="11" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           TextTrimming="CharacterEllipsis" 
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Logout Button -->
                        <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding LogoutCommand}" HorizontalAlignment="Stretch" Height="36" FontWeight="Bold" FontSize="13" ToolTip="تسجيل الخروج">
                            <DockPanel HorizontalAlignment="Center">
                                <Path Style="{StaticResource SidebarIconStyle}" Data="{StaticResource IconLogout}" Fill="White" Width="14" Height="14" />
                                <TextBlock Style="{StaticResource SidebarItemTextStyle}" Text="تسجيل الخروج" Foreground="White" />
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════ MAIN CONTENT AREA & HEADER ════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                <DockPanel>
                    <Button Content="☰" Click="ToggleSidebar_Click" Style="{StaticResource GhostButtonStyle}" Padding="10,4" Margin="0,0,12,0" DockPanel.Dock="Left" ToolTip="إظهار أو إخفاء القائمة (F11)" AutomationProperties.Name="قائمة التنقل" />
<!-- Current Page Title -->
                    <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource H2TextBlockStyle}" VerticalAlignment="Center" />

                    <!-- Top Right Actions: Theme Switcher & User Profile -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- Dark / Light Theme Toggle Button -->
                        <Button Command="{Binding ToggleThemeCommand}" 
                                Style="{StaticResource GhostButtonStyle}" 
                                Padding="10,6" Margin="0,0,12,0" 
                                ToolTip="تبديل الوضع الداكن / الفاتح">
                            <DockPanel>
                                <Path Data="{StaticResource IconMoon}" 
                                      Fill="{DynamicResource TextPrimaryBrush}" 
                                      Width="14" Height="14" Stretch="Uniform" 
                                      VerticalAlignment="Center" Margin="0,0,6,0" 
                                      Visibility="{Binding IsDarkMode, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <Path Data="{StaticResource IconSun}" 
                                      Fill="{DynamicResource WarningBrush}" 
                                      Width="14" Height="14" Stretch="Uniform" 
                                      VerticalAlignment="Center" Margin="0,0,6,0" 
                                      Visibility="{Binding IsDarkMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock  
                                           FontFamily="{StaticResource AppFontFamily}" 
                                           FontSize="12" FontWeight="SemiBold" 
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="الوضع الداكن" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                    <Setter Property="Text" Value="الوضع الفاتح" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Active View Presenter -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
        </Grid>

        <!-- ════════════ FLOATING TOAST NOTIFICATIONS LAYER ════════════ -->
        <controls:ToastNotificationControl Grid.Column="1" 
                                           DataContext="{Binding ToastService}" 
                                           HorizontalAlignment="Left" 
                                           VerticalAlignment="Top" 
                                           Margin="20,16,0,0" />
    </Grid>
</Window>
