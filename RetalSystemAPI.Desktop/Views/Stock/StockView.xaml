<UserControl x:Class="RetalSystemAPI.Desktop.Views.Stock.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:RetalSystemAPI.Desktop.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900" FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <Button Content="تحديث الأرصدة" Command="{Binding RefreshCurrentTabCommand}" DockPanel.Dock="Left" Height="36" Padding="16,0" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryOnBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <TextBlock Text="📦 إدارة وتسويه المخزون" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Warehouse Selector & Search Bar Card -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="220" Height="34" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,8,0" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" ToolTip="اكتب اسم الصنف أو الباركود">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="🔍 بحث" Command="{Binding SearchCommand}" Height="34" Padding="15,0" Background="{DynamicResource TextPrimaryBrush}" Foreground="{DynamicResource SurfaceBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" />
                    <CheckBox Content="مطابقة الباركود تماماً" IsChecked="{Binding ExactBarcodeMatch}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="يقتصر البحث على التطابق التام مع رقم الباركود" Margin="0,0,8,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="المخزن / الصالة المحدد:" VerticalAlignment="Center" Margin="5,0,10,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox ItemsSource="{Binding FilteredWarehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" Width="220" Height="34" VerticalContentAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <!-- Tab 1: Storage Stock -->
            <TabItem Header="🏬 مخزون التخزين (بالباركود)" FontSize="14" FontWeight="SemiBold" Padding="15,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <DataGrid Grid.Row="0" ItemsSource="{Binding StorgeStocks}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" RowHeight="46" Background="{DynamicResource SurfaceBrush}">
                        <DataGrid.Columns>
                            <!-- Image Thumbnail -->
                            <DataGridTemplateColumn Header="الصورة" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource SurfaceActiveBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image helpers:ImageHelper.SourceUrl="{Binding DisplayImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="2*"/>
                            <DataGridTextColumn Header="عنصر الباركود" Binding="{Binding BarcodeTitle}" Width="2*"/>
                            <DataGridTextColumn Header="الباركود" Binding="{Binding BarcodeValue}" Width="2*"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="1*"/>
                            <DataGridTextColumn Header="الحد الأدنى" Binding="{Binding MinStockLevel}" Width="1*"/>
                            <DataGridCheckBoxColumn Header="نقص بالمخزون" Binding="{Binding IsBelowMinLevel}" Width="1*"/>
                            <DataGridTemplateColumn Header="تعديل الرصيد" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="تسويه" Command="{Binding DataContext.EditStorgeStockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="{DynamicResource WarningBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="10,4" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination Controls -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8" Margin="0,4,0,0">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="إجمالي السجلات: " Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="◀ السابق" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}" Height="30" Padding="12,0" Margin="4,0" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand" />
                                <TextBlock VerticalAlignment="Center" Margin="8,0">
                                    <Run Text="الصفحة " Foreground="{DynamicResource TextMutedBrush}" />
                                    <Run Text="{Binding PageNumber}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                                    <Run Text=" من " Foreground="{DynamicResource TextMutedBrush}" />
                                    <Run Text="{Binding TotalPages}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </TextBlock>
                                <Button Content="التالي ▶" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Height="30" Padding="12,0" Margin="4,0" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Showroom Stock -->
            <TabItem Header="🛍️ مخزون صالة العرض (بالمنتج)" FontSize="14" FontWeight="SemiBold" Padding="15,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding ShowroomStocks}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" RowHeight="46" Background="{DynamicResource SurfaceBrush}">
                        <DataGrid.Columns>
                            <!-- Image Thumbnail -->
                            <DataGridTemplateColumn Header="الصورة" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource SurfaceActiveBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="🛍️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image helpers:ImageHelper.SourceUrl="{Binding DisplayImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="3*"/>
                            <DataGridTextColumn Header="الكمية بالصالة" Binding="{Binding Quantity}" Width="1.5*"/>
                            <DataGridTextColumn Header="الحد الأدنى" Binding="{Binding MinStockLevel}" Width="1.5*"/>
                            <DataGridCheckBoxColumn Header="نقص بالمخزون" Binding="{Binding IsBelowMinLevel}" Width="1.5*"/>
                            <DataGridTemplateColumn Header="تعديل الرصيد" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="تسويه" Command="{Binding DataContext.EditShowroomStockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="{DynamicResource WarningBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="10,4" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination Controls -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8" Margin="0,4,0,0">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="إجمالي السجلات: " Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="◀ السابق" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}" Height="30" Padding="12,0" Margin="4,0" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand" />
                                <TextBlock VerticalAlignment="Center" Margin="8,0">
                                    <Run Text="الصفحة " Foreground="{DynamicResource TextMutedBrush}" />
                                    <Run Text="{Binding PageNumber}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                                    <Run Text=" من " Foreground="{DynamicResource TextMutedBrush}" />
                                    <Run Text="{Binding TotalPages}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </TextBlock>
                                <Button Content="التالي ▶" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Height="30" Padding="12,0" Margin="4,0" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 3: Low Stock Alerts -->
            <TabItem Header="⚠️ تنبيهات الرصيد المنخفض" FontSize="14" FontWeight="SemiBold" Padding="15,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="تنبيهات مخازن التخزين (Storge Alerts)" FontWeight="Bold" Foreground="{DynamicResource DangerHoverBrush}" FontSize="16" Margin="0,5,0,10"/>
                        <DataGrid ItemsSource="{Binding LowStorgeAlerts}" AutoGenerateColumns="False" IsReadOnly="True" Height="180" HeadersVisibility="Column" Background="{DynamicResource SurfaceBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المخزن" Binding="{Binding WarehouseName}" Width="1.5*"/>
                                <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="2*"/>
                                <DataGridTextColumn Header="الباركود" Binding="{Binding BarcodeValue}" Width="1.5*"/>
                                <DataGridTextColumn Header="الكمية الحالية" Binding="{Binding Quantity}" Width="1*"/>
                                <DataGridTextColumn Header="الحد الأدنى" Binding="{Binding MinStockLevel}" Width="1*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="تنبيهات صالات العرض (Showroom Alerts)" FontWeight="Bold" Foreground="{DynamicResource DangerHoverBrush}" FontSize="16" Margin="0,15,0,10"/>
                        <DataGrid ItemsSource="{Binding LowShowroomAlerts}" AutoGenerateColumns="False" IsReadOnly="True" Height="180" HeadersVisibility="Column" Background="{DynamicResource SurfaceBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الصالة" Binding="{Binding WarehouseName}" Width="2*"/>
                                <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="3*"/>
                                <DataGridTextColumn Header="الكمية الحالية" Binding="{Binding Quantity}" Width="1.5*"/>
                                <DataGridTextColumn Header="الحد الأدنى" Binding="{Binding MinStockLevel}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
