<Window x:Class="RetalSystemAPI.Desktop.Views.Stock.StockAdjustmentFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:warehouses="clr-namespace:RetalSystemAPI.Desktop.Models.Warehouses"
        Title="تسجيل تسوية جردية" Height="680" Width="820"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="#FFFFFF" ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="⚖️ تسجيل تسوية جردية وضبط الفوارق المخزنية" 
                   FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Master Info -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="رقم التسوية *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AdjustmentNumber, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center" Padding="8,0" Background="#F9FAFB" IsReadOnly="{Binding IsViewOnly}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,6,0">
                        <TextBlock Text="المستودع / الصالة المعنية *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" Height="36" VerticalContentAlignment="Center" IsEnabled="{Binding IsViewOnly, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                        <TextBlock Text="سبب التسوية *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding Reason}" SelectedValuePath="Tag" Height="36" VerticalContentAlignment="Center" IsEnabled="{Binding IsViewOnly, Converter={StaticResource InverseBoolConverter}}">
                            <ComboBoxItem Content="جرد دوري / سنوي" Tag="{x:Static warehouses:StockAdjustmentReason.InventoryCount}" IsSelected="True"/>
                            <ComboBoxItem Content="بضاعة تالفة" Tag="{x:Static warehouses:StockAdjustmentReason.DamagedGoods}"/>
                            <ComboBoxItem Content="بضاعة منتهية الصلاحية" Tag="{x:Static warehouses:StockAdjustmentReason.ExpiredGoods}"/>
                            <ComboBoxItem Content="فقدان أو سرقة" Tag="{x:Static warehouses:StockAdjustmentReason.TheftOrLoss}"/>
                            <ComboBoxItem Content="بضاعة معثور عليها زائفة" Tag="{x:Static warehouses:StockAdjustmentReason.FoundStock}"/>
                            <ComboBoxItem Content="تصحيح خطأ إدخال" Tag="{x:Static warehouses:StockAdjustmentReason.DataEntryCorrection}"/>
                            <ComboBoxItem Content="أسباب أخرى" Tag="{x:Static warehouses:StockAdjustmentReason.Other}"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Add Items Section (visible only in create mode) -->
                <Border Background="#F9FAFB" CornerRadius="8" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,12"
                        Visibility="{Binding IsViewOnly, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="📊 إضافة بنود الأصناف للجرد" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="الصنف" FontSize="11" Foreground="#6B7280"/>
                                <ComboBox ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProductToAdd}" DisplayMemberPath="Name" Height="34" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="الكمية الدفترية" FontSize="11" Foreground="#6B7280"/>
                                <TextBox Text="{Binding SystemQuantityToAdd, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="6,0" Background="#FFFFFF"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                <TextBlock Text="الكمية الفعلية" FontSize="11" Foreground="#6B7280"/>
                                <TextBox Text="{Binding ActualQuantityToAdd, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="6,0" Background="#FFFFFF"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="4,0,4,0">
                                <TextBlock Text="التكلفة التقديرية" FontSize="11" Foreground="#6B7280"/>
                                <TextBox Text="{Binding UnitCostToAdd, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="6,0" Background="#FFFFFF"/>
                            </StackPanel>

                            <Button Grid.Column="4" Content="+ إضافة" Command="{Binding AddItemCommand}" VerticalAlignment="Bottom" Height="34" Padding="14,0" Background="#38E07B" Foreground="#0F291E" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Items DataGrid -->
                <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,12">
                    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="140" MaxHeight="220" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" Width="2.5*"/>
                            <DataGridTextColumn Header="الكمية الدفترية (النظام)" Binding="{Binding SystemQuantity}" Width="1.3*"/>
                            <DataGridTextColumn Header="الكمية الفعلية (الجرد)" Binding="{Binding ActualQuantity}" Width="1.3*"/>
                            <DataGridTextColumn Header="الفارق" Binding="{Binding DifferenceQuantity}" Width="1*"/>
                            <DataGridTemplateColumn Header="حذف" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Width="24" Height="24" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock Text="ملاحظات التسوية" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#F9FAFB" IsReadOnly="{Binding IsViewOnly}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="حفظ وتطبيق التسوية الجردية" Command="{Binding SaveCommand}" DockPanel.Dock="Left" Height="40" Padding="24,0" Background="#38E07B" Foreground="#0F291E" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Visibility="{Binding IsViewOnly, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
