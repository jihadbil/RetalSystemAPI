<UserControl x:Class="RetalSystemAPI.Desktop.Views.Stock.StockTransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:warehouses="clr-namespace:RetalSystemAPI.Desktop.Models.Warehouses"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950" FlowDirection="RightToLeft" Background="#F6F8F7">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <Button Content="+ إنشاء أمر تحويل مخزني جديد" Command="{Binding CreateTransferCommand}" DockPanel.Dock="Left" Height="36" Padding="16,0" Background="#38E07B" Foreground="#0F291E" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <TextBlock Text="🚚 التحويلات ونقل البضائع بين المخازن" FontSize="22" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Filter Bar Card -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="5,0,5,0" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#F9FAFB"/>

                <TextBlock Grid.Column="2" Text="من مستودع:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold" Foreground="#111827"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedFromWarehouse}" DisplayMemberPath="Name" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="4" Text="إلى مستودع:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold" Foreground="#111827"/>
                <ComboBox Grid.Column="5" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedToWarehouse}" DisplayMemberPath="Name" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="6" Text="الحالة:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold" Foreground="#111827"/>
                <ComboBox Grid.Column="7" SelectedValue="{Binding SelectedStatus}" SelectedValuePath="Tag" Height="34" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="الكل" Tag="{x:Null}" IsSelected="True"/>
                    <ComboBoxItem Content="مسودة" Tag="{x:Static warehouses:StockTransferStatus.Draft}"/>
                    <ComboBoxItem Content="مؤكد" Tag="{x:Static warehouses:StockTransferStatus.Confirmed}"/>
                    <ComboBoxItem Content="مرحل ومكتمل" Tag="{x:Static warehouses:StockTransferStatus.Completed}"/>
                    <ComboBoxItem Content="ملغي" Tag="{x:Static warehouses:StockTransferStatus.Cancelled}"/>
                </ComboBox>

                <Button Grid.Column="8" Content="تحديث" Command="{Binding LoadTransfersCommand}" Margin="10,0,0,0" Padding="15,0" Height="34" Background="#111827" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- DataGrid Card -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Transfers}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="#F3F4F6" Background="Transparent" RowHeight="42">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم أمر التحويل" Binding="{Binding TransferNumber}" Width="1.5*"/>
                    <DataGridTextColumn Header="من مستودع/صالة" Binding="{Binding FromWarehouseName}" Width="1.5*"/>
                    <DataGridTextColumn Header="إلى مستودع/صالة" Binding="{Binding ToWarehouseName}" Width="1.5*"/>
                    <DataGridTextColumn Header="تاريخ التحويل" Binding="{Binding TransferDate, StringFormat={}{0:yyyy-MM-dd}}" Width="1.2*"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusName}" Width="1.2*"/>
                    <DataGridTextColumn Header="عدد الأصناف" Binding="{Binding ItemCount}" Width="1*"/>
                    <DataGridTemplateColumn Header="الإجراءات" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="⚡ ترحيل/اكتمال" Command="{Binding DataContext.UpdateStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" Background="#38E07B" Foreground="#0F291E" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="التقدم بالحالة وترحيل المخزون آلياً"/>
                                    <Button Content="تعديل/عرض" Command="{Binding DataContext.EditTransferCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="حذف" Command="{Binding DataContext.DeleteTransferCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination -->
        <DockPanel Grid.Row="3" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="السابق" Command="{Binding PrevPageCommand}" Height="32" Padding="14,0" Margin="0,0,5,0" Background="#FFFFFF" Foreground="#111827" FontWeight="Bold" BorderBrush="#E5E7EB" BorderThickness="1" Cursor="Hand"/>
                <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#38E07B" Margin="5,0"/>
                <TextBlock Text="من" VerticalAlignment="Center" Foreground="#6B7280" Margin="2,0"/>
                <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#111827" Margin="5,0"/>
                <Button Content="التالي" Command="{Binding NextPageCommand}" Height="32" Padding="14,0" Margin="5,0,0,0" Background="#FFFFFF" Foreground="#111827" FontWeight="Bold" BorderBrush="#E5E7EB" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</UserControl>
