<UserControl x:Class="RetalSystemAPI.Desktop.Views.Purchase.PurchaseInvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RetalSystemAPI.Desktop.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100" FlowDirection="RightToLeft" Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════ HEADER ════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Content="+ إضافة فاتورة مشتريات مباشرة" Command="{Binding CreateInvoiceCommand}" Style="{StaticResource PrimaryButtonStyle}" DockPanel.Dock="Left" Height="40" Padding="16,0" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📥 فواتير المشتريات المباشرة" Style="{StaticResource H2TextBlockStyle}" VerticalAlignment="Center" />
                <Border Background="{DynamicResource SuccessLightBrush}" CornerRadius="12" Padding="10,4" Margin="12,0,0,0">
                    <TextBlock Text="{Binding TotalCount, StringFormat={}{0} فاتورة}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="12" />
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- ════════ FILTER BAR ════════ -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBox Grid.Column="0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,0,10,0" Height="36" VerticalContentAlignment="Center" Padding="8,0" Tag="بحث برقم الفاتورة أو المورد..." />

                <!-- Branch Filter -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name" Margin="0,0,10,0" Height="36" VerticalContentAlignment="Center" />

                <!-- Supplier Filter -->
                <ComboBox Grid.Column="2" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Margin="0,0,10,0" Height="36" VerticalContentAlignment="Center" />

                <!-- Warehouse Filter -->
                <ComboBox Grid.Column="3" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" Margin="0,0,10,0" Height="36" VerticalContentAlignment="Center" />

                <!-- Actions -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="🔍 بحث" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="14,0" Margin="0,0,6,0"/>
                    <Button Content="إلغاء الفلترة" Command="{Binding ResetFilterCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="10,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════ DATA GRID ════════ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" RowHeight="44" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="1.5*" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat={}{0:yyyy/MM/dd HH:mm}}" Width="1.4*"/>
                    <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="1.5*"/>
                    <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="1.2*"/>
                    <DataGridTextColumn Header="المستودع المستلم" Binding="{Binding WarehouseName}" Width="1.4*"/>
                    <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethodName}" Width="1*"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat={}{0:N2} د.ل}" Width="1.2*" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                    <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat={}{0:N2} د.ل}" Width="1.1*"/>
                    <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat={}{0:N2} د.ل}" Width="1.1*" Foreground="{DynamicResource DangerHoverBrush}"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusName}" Width="1*"/>

                    <!-- Action Buttons -->
                    <DataGridTemplateColumn Header="الإجراءات" Width="1.8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="👁️ تفاصيل" Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Height="28" Padding="8,0" Margin="0,0,4,0" Background="{DynamicResource AccentLightBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                    <Button Content="🚫 إلغاء" Command="{Binding DataContext.CancelInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Height="28" Padding="8,0" Margin="0,0,4,0" Background="{DynamicResource DangerLightBrush}" Foreground="{DynamicResource DangerHoverBrush}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                    <Button Content="🗑️ حذف" Command="{Binding DataContext.DeleteInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Height="28" Padding="8,0" Background="{DynamicResource SurfaceActiveBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ════════ PAGINATION FOOTER ════════ -->
        <controls:PaginationControl Grid.Row="3" Margin="0,12,0,0" CurrentPage="{Binding CurrentPage}" TotalPages="{Binding TotalPages}" PageSize="{Binding PageSize, Mode=TwoWay}" IsLoading="{Binding IsLoading}" NextPageCommand="{Binding NextPageCommand}" PrevPageCommand="{Binding PreviousPageCommand}" />
        <controls:ListFeedback Grid.Row="2" ItemsCount="{Binding Invoices.Count}" IsLoading="{Binding IsLoading}" Message="{Binding ErrorMessage}" RetryCommand="{Binding LoadInvoicesCommand}" />
        <controls:LoadingOverlay Grid.RowSpan="4" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>
