<Window x:Class="RetalSystemAPI.Desktop.Views.Purchase.PurchaseReturnFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:purchase="clr-namespace:RetalSystemAPI.Desktop.Models.Purchase"
        xmlns:sales="clr-namespace:RetalSystemAPI.Desktop.Models.Sales"
        Title="إشعار مرتجع مشتريات" Height="730" Width="880"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="{DynamicResource SurfaceBrush}" ResizeMode="NoResize" Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconReturns}" Fill="{DynamicResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="🔄 إشعار مرتجع مشتريات وخصم البضاعة من المخزن" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Master Info Card -->
                <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <!-- Row 1: Return Number, Branch, Supplier, Warehouse -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="رقم إشعار المرتجع *" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ReturnNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Height="36" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource SurfaceBrush}" IsReadOnly="{Binding IsViewOnly}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                <TextBlock Text="الفرع *" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name" Height="36" VerticalContentAlignment="Center" IsEnabled="{Binding IsViewOnly, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                <TextBlock Text="المورد *" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Height="36" VerticalContentAlignment="Center" IsEnabled="{Binding IsViewOnly, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                <TextBlock Text="المخزن المسترجع منه *" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" Height="36" VerticalContentAlignment="Center" IsEnabled="{Binding IsViewOnly, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Original Invoice (optional), Payment Method, Reason, Date -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="الفاتورة الأصلية (اختياري)" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SupplierInvoices}" SelectedItem="{Binding SelectedInvoice}" DisplayMemberPath="InvoiceNumber" Height="36" VerticalContentAlignment="Center" IsEnabled="{Binding IsViewOnly, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                <TextBlock Text="طريقة التسوية المالية *" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding PaymentMethod}" SelectedValuePath="Tag" Height="36" VerticalContentAlignment="Center" IsEnabled="{Binding IsViewOnly, Converter={StaticResource InverseBoolConverter}}">
                                    <ComboBoxItem Content="💵 نقداً (استرداد نقدية)" Tag="{x:Static sales:PaymentMethod.Cash}" IsSelected="True"/>
                                    <ComboBoxItem Content="📑 آجل (تخفيض حساب المورد)" Tag="{x:Static sales:PaymentMethod.Credit}"/>
                                    <ComboBoxItem Content="💳 تحويل بنكي / بطاقة" Tag="{x:Static sales:PaymentMethod.Card}"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                <TextBlock Text="سبب الإرجاع *" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Reason}" SelectedValuePath="Tag" Height="36" VerticalContentAlignment="Center" IsEnabled="{Binding IsViewOnly, Converter={StaticResource InverseBoolConverter}}">
                                    <ComboBoxItem Content="بضاعة معيبة أو تالفة" Tag="{x:Static purchase:PurchaseReturnReason.Defective}" IsSelected="True"/>
                                    <ComboBoxItem Content="غير مطابق للمواصفات" Tag="{x:Static purchase:PurchaseReturnReason.WrongSpecification}"/>
                                    <ComboBoxItem Content="منتهي أو قريب الصلاحية" Tag="{x:Static purchase:PurchaseReturnReason.NearExpiryOrExpired}"/>
                                    <ComboBoxItem Content="فائض مخزون / اتفاق" Tag="{x:Static purchase:PurchaseReturnReason.ExcessStock}"/>
                                    <ComboBoxItem Content="أسباب أخرى" Tag="{x:Static purchase:PurchaseReturnReason.Other}"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                <TextBlock Text="تاريخ الإرجاع" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding ReturnDate}" Height="36" IsEnabled="{Binding IsViewOnly, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Notes -->
                        <StackPanel>
                            <TextBlock Text="ملاحظات" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource SurfaceBrush}" IsReadOnly="{Binding IsViewOnly}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Add Items Section (visible only when creating) -->
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14"
                        Visibility="{Binding IsViewOnly, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="📦 إضافة أصناف ونكهات البضاعة المرتجعة" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="بحث بالاسم أو الباركود *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ProductSearchTerm, UpdateSourceTrigger=PropertyChanged, Delay=300}" Height="36" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource SurfaceHoverBrush}"/>
                                <CheckBox Content="مطابقة الباركود تماماً" IsChecked="{Binding ExactBarcodeMatch}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" ToolTip="يقتصر البحث على التطابق التام مع رقم الباركود"/>
                                <TextBlock Text="الصنف (اكتب للبحث)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProductToAdd}" DisplayMemberPath="Name" Height="34" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                <TextBlock Text="النكهة / الباركود *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableBarcodes}" SelectedItem="{Binding SelectedBarcodeToAdd}" DisplayMemberPath="Title" Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                <TextBlock Text="الكمية *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding QuantityToAdd, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Height="36" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource SurfaceHoverBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="6,0,6,0">
                                <TextBlock Text="سعر الوحدة *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding UnitPriceToAdd, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Height="36" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource SurfaceHoverBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="4" Content="+ إضافة" Command="{Binding AddItemCommand}" VerticalAlignment="Bottom" Height="36" Padding="18,0" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryOnBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Items DataGrid -->
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="140" MaxHeight="220" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" Background="Transparent" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" Width="2.5*"/>
                            <DataGridTextColumn Header="النكهة / الباركود" Binding="{Binding BarcodeTitle}" Width="1.8*"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="1*"/>
                            <DataGridTextColumn Header="سعر الإرجاع" Binding="{Binding UnitPrice, StringFormat={}{0:N2} د.ل}" Width="1.3*"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat={}{0:N2} د.ل}" Width="1.3*"/>
                            <DataGridTemplateColumn Header="إجراء" Width="60" Visibility="{Binding DataContext.IsViewOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="{DynamicResource DangerBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Width="26" Height="26" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" Margin="0,0,0,10" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Action Bar -->
        <Border Grid.Row="2" Padding="0,14,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <!-- Total Amount Display -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="إجمالي قيمة المرتجع: " FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2} د.ل}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="إلغاء / إغلاق" Command="{Binding CancelCommand}" Height="38" Padding="20,0" Margin="0,0,10,0" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="💾 تأكيد وحفظ المرتجع" Command="{Binding SaveCommand}" Height="38" Padding="24,0" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryOnBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Visibility="{Binding IsViewOnly, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
