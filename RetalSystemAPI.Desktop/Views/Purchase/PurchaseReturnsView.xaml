<UserControl x:Class="RetalSystemAPI.Desktop.Views.Purchase.PurchaseReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RetalSystemAPI.Desktop.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:purchase="clr-namespace:RetalSystemAPI.Desktop.Models.Purchase"
             xmlns:sales="clr-namespace:RetalSystemAPI.Desktop.Models.Sales"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1050" FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <Button Content="+ تسجيل مرتجع مشتريات جديد" Command="{Binding CreateReturnCommand}" DockPanel.Dock="Left" Height="38" Padding="18,0" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryOnBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconReturns}" Fill="{DynamicResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="مرتجعات المشتريات للموردين" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- Filter Bar Card -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="5,0,5,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource SurfaceHoverBrush}"/>

                <TextBlock Grid.Column="2" Text="الفرع:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="4" Text="المورد:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ComboBox Grid.Column="5" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="6" Text="المخزن:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ComboBox Grid.Column="7" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="8" Text="السبب:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ComboBox Grid.Column="9" SelectedValue="{Binding SelectedReason}" SelectedValuePath="Tag" Height="34" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="الكل" Tag="{x:Null}" IsSelected="True"/>
                    <ComboBoxItem Content="بضاعة معيبة أو تالفة" Tag="{x:Static purchase:PurchaseReturnReason.Defective}"/>
                    <ComboBoxItem Content="غير مطابق للمواصفات" Tag="{x:Static purchase:PurchaseReturnReason.WrongSpecification}"/>
                    <ComboBoxItem Content="منتهي أو قريب الصلاحية" Tag="{x:Static purchase:PurchaseReturnReason.NearExpiryOrExpired}"/>
                    <ComboBoxItem Content="فائض مخزون / مرتجع" Tag="{x:Static purchase:PurchaseReturnReason.ExcessStock}"/>
                    <ComboBoxItem Content="أسباب أخرى" Tag="{x:Static purchase:PurchaseReturnReason.Other}"/>
                </ComboBox>

                <Button Grid.Column="10" Content="تحديث" Command="{Binding LoadReturnsCommand}" Margin="12,0,0,0" Padding="16,0" Height="34" Background="{DynamicResource TextPrimaryBrush}" Foreground="{DynamicResource SurfaceBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- DataGrid Card -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Returns}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" Background="Transparent" RowHeight="44">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم المرتجع" Binding="{Binding ReturnNumber}" Width="1.4*"/>
                    <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="1.5*"/>
                    <DataGridTextColumn Header="المخزن الخارج منه" Binding="{Binding WarehouseName}" Width="1.4*"/>
                    <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="1.1*"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding ReturnDate, StringFormat={}{0:yyyy-MM-dd}}" Width="1*"/>
                    <DataGridTextColumn Header="السبب" Binding="{Binding ReasonName}" Width="1.4*"/>
                    <DataGridTextColumn Header="طريقة التسوية" Binding="{Binding PaymentMethodName}" Width="1.2*"/>
                    <DataGridTextColumn Header="قيمة المرتجع" Binding="{Binding TotalAmount, StringFormat={}{0:N2} د.ل}" Width="1.2*"/>
                    <DataGridTextColumn Header="عدد الأصناف" Binding="{Binding ItemCount}" Width="0.9*"/>
                    <DataGridTemplateColumn Header="الإجراءات" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="عرض التفاصيل" Command="{Binding DataContext.ViewReturnDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="3,0" Padding="8,4" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Style="{StaticResource TextButtonStyle}" Foreground="{DynamicResource DangerBrush}" Content="حذف" Command="{Binding DataContext.DeleteReturnCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="3,0" Padding="8,4" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination & List Feedback -->
        <controls:PaginationControl Grid.Row="3" Margin="0,12,0,0" CurrentPage="{Binding CurrentPage}" TotalPages="{Binding TotalPages}" PageSize="{Binding PageSize, Mode=TwoWay}" IsLoading="{Binding IsLoading}" NextPageCommand="{Binding NextPageCommand}" PrevPageCommand="{Binding PrevPageCommand}" />
        <controls:ListFeedback Grid.Row="2" ItemsCount="{Binding Returns.Count}" IsLoading="{Binding IsLoading}" Message="{Binding ErrorMessage}" RetryCommand="{Binding LoadReturnsCommand}" />
        <controls:LoadingOverlay Grid.RowSpan="4" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>
