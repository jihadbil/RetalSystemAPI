<UserControl x:Class="RetalSystemAPI.Desktop.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RetalSystemAPI.Desktop.Controls"
             FlowDirection="RightToLeft">
    <Grid Margin="24" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="لوحة التحكم الإحصائية" Style="{StaticResource H1TextBlockStyle}" Margin="0,0,0,24" />

        <UniformGrid Grid.Row="1" Columns="4" VerticalAlignment="Top">
            <!-- Card 1: Tenants -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="8">
                <StackPanel>
                    <TextBlock Text="المستأجرون" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{Binding TenantsCount}" Style="{StaticResource H1TextBlockStyle}" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 2: Branches -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="8">
                <StackPanel>
                    <TextBlock Text="الفروع النشطة" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{Binding BranchesCount}" Style="{StaticResource H1TextBlockStyle}" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 3: Products -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="8">
                <StackPanel>
                    <TextBlock Text="إجمالي المنتجات" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{Binding ProductsCount}" Style="{StaticResource H1TextBlockStyle}" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 4: Categories -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="8">
                <StackPanel>
                    <TextBlock Text="التصنيفات" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{Binding CategoriesCount}" Style="{StaticResource H1TextBlockStyle}" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <controls:LoadingOverlay Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>
