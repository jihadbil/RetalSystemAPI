<UserControl x:Class="RetalSystemAPI.Desktop.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RetalSystemAPI.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RetalSystemAPI.Desktop.ViewModels.Dashboard"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             FlowDirection="RightToLeft" Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ════════════════════ TOP HEADER BAR ════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Status -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDashboard}" Fill="{DynamicResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="لوحة التحكم والمؤشرات الحية" Style="{StaticResource H1TextBlockStyle}" />
                            <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Filter & Action Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Branch Selector -->
                    <ComboBox ItemsSource="{Binding Branches}" 
                              SelectedItem="{Binding SelectedBranch}" 
                              DisplayMemberPath="Name" 
                              Width="180" 
                              Height="40" 
                              Margin="0,0,10,0" 
                              VerticalContentAlignment="Center" />

                    <!-- Refresh Button -->
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="40" Padding="14,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="تحديث" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Fast POS Launch Button -->
                    <Button Command="{Binding NavigateToPosCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="18,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPos}" Fill="{DynamicResource PrimaryOnBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="نقطة البيع السريعة (POS)" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════ DASHBOARD SCROLLABLE CONTENT ════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24" MaxWidth="1600" HorizontalAlignment="Stretch">

                <!-- ── 1. FINANCIAL HERO METRIC CARDS ── -->
                <TextBlock Text="المؤشرات المالية اليومية" Style="{StaticResource H2TextBlockStyle}" Margin="0,0,0,14" />
                <UniformGrid Columns="4" Margin="-8,0,-8,20">

                    <!-- Card 1: Today Sales -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="8" Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="إجمالي مبيعات اليوم" Style="{StaticResource CaptionTextBlockStyle}" />
                            <Border Grid.Row="0" Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource PrimaryLightBrush}" VerticalAlignment="Top">
                                <Path Data="{StaticResource IconSales}" Fill="{DynamicResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,4">
                                <TextBlock Text="{Binding Kpis.TodaySales, StringFormat={}{0:N2}}" Style="{StaticResource H1TextBlockStyle}" Foreground="{DynamicResource PrimaryBrush}" FontSize="24" />
                                <TextBlock Text=" د.ل" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <Border CornerRadius="4" Background="{DynamicResource SuccessLightBrush}" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Kpis.SalesGrowthPercentage, StringFormat={}{0:+0.0;-0.0;0}%}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="11" />
                                </Border>
                                <TextBlock Text="مقارنة بمبيعات الأمس" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2: Today Net Profit -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="8" Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="صافي الأرباح اليومية" Style="{StaticResource CaptionTextBlockStyle}" />
                            <Border Grid.Row="0" Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource SuccessLightBrush}" VerticalAlignment="Top">
                                <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource SuccessBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,4">
                                <TextBlock Text="{Binding Kpis.TodayProfit, StringFormat={}{0:N2}}" Style="{StaticResource H1TextBlockStyle}" Foreground="{DynamicResource SuccessBrush}" FontSize="24" />
                                <TextBlock Text=" د.ل" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="الأرباح المحققة بعد خصم التكلفة" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" Margin="0,4,0,0" />
                        </Grid>
                    </Border>

                    <!-- Card 3: Today Orders / Invoices Count -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="8" Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="فواتير المبيعات اليوم" Style="{StaticResource CaptionTextBlockStyle}" />
                            <Border Grid.Row="0" Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AccentLightBrush}" VerticalAlignment="Top">
                                <Path Data="{StaticResource IconInvoices}" Fill="{DynamicResource AccentBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,4">
                                <TextBlock Text="{Binding Kpis.TodayOrdersCount}" Style="{StaticResource H1TextBlockStyle}" Foreground="{DynamicResource AccentBrush}" FontSize="24" />
                                <TextBlock Text=" فاتورة" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="متوسط الفاتورة: " Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" />
                                <TextBlock Text="{Binding Kpis.AverageOrderValue, StringFormat={}{0:N1} د.ل}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 4: Purchases Today & Monthly -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="8" Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="مشتريات اليوم المباشرة" Style="{StaticResource CaptionTextBlockStyle}" />
                            <Border Grid.Row="0" Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource WarningLightBrush}" VerticalAlignment="Top">
                                <Path Data="{StaticResource IconPurchases}" Fill="{DynamicResource WarningBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,4">
                                <TextBlock Text="{Binding Kpis.TodayPurchases, StringFormat={}{0:N2}}" Style="{StaticResource H1TextBlockStyle}" Foreground="{DynamicResource WarningBrush}" FontSize="24" />
                                <TextBlock Text=" د.ل" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="مشتريات هذا الشهر: " Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" />
                                <TextBlock Text="{Binding Kpis.ThisMonthPurchases, StringFormat={}{0:N0} د.ل}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- ── 2. SECONDARY METRIC COUNTERS (ORGANIZATION COUNTS) ── -->
                <UniformGrid Columns="4" Margin="-8,0,-8,24">
                    <!-- Products & Categories -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="8" Background="{DynamicResource SurfaceBrush}" Padding="16">
                        <DockPanel>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconProducts}" Fill="{DynamicResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="الأصناف والتصنيفات" Style="{StaticResource CaptionTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Counts.ProductsCount}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text=" صنف (" Style="{StaticResource CaptionTextBlockStyle}" Margin="4,0,0,0" />
                                    <TextBlock Text="{Binding Counts.CategoriesCount}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Text=" تصنيف)" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Branches & Warehouses -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="8" Background="{DynamicResource SurfaceBrush}" Padding="16">
                        <DockPanel>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource SuccessLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBranches}" Fill="{DynamicResource SuccessBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="الفروع والمستودعات" Style="{StaticResource CaptionTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Counts.BranchesCount}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text=" فرع (" Style="{StaticResource CaptionTextBlockStyle}" Margin="4,0,0,0" />
                                    <TextBlock Text="{Binding Counts.WarehousesCount}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SuccessBrush}" />
                                    <TextBlock Text=" مخزن)" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Customers & Receivables -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="8" Background="{DynamicResource SurfaceBrush}" Padding="16">
                        <DockPanel>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCustomers}" Fill="{DynamicResource AccentBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="العملاء والديون المتبقية" Style="{StaticResource CaptionTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Counts.CustomersCount}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text=" عميل | " Style="{StaticResource CaptionTextBlockStyle}" Margin="4,0,4,0" />
                                    <TextBlock Text="{Binding Kpis.TotalReceivables, StringFormat={}{0:N0} د.ل}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource DangerBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Suppliers & Payables -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="8" Background="{DynamicResource SurfaceBrush}" Padding="16">
                        <DockPanel>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource WarningLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSuppliers}" Fill="{DynamicResource WarningBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="الموردون والمستحقات" Style="{StaticResource CaptionTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Counts.SuppliersCount}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text=" مورد | " Style="{StaticResource CaptionTextBlockStyle}" Margin="4,0,4,0" />
                                    <TextBlock Text="{Binding Kpis.TotalPayables, StringFormat={}{0:N0} د.ل}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource WarningBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </UniformGrid>

                <!-- ── 3. MAIN ANALYTICS GRID (CHART + TOP PRODUCTS & RADAR + RECENT INVOICES) ── -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <!-- Left Column: Chart & Top Selling (60%) -->
                        <ColumnDefinition Width="3*" />
                        <!-- Right Column: Low Stock Radar & Recent Invoices (2*) -->
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- ════════ LEFT COLUMN ════════ -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">

                        <!-- Weekly Sales Trend Interactive Bar Chart -->
                        <Border Style="{StaticResource CardBorderStyle}" Background="{DynamicResource SurfaceBrush}" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="حركة المبيعات اليومية (آخر 7 أيام)" Style="{StaticResource H2TextBlockStyle}" />
                                        <TextBlock Text="توزيع إجمالي الإيرادات اليومية ومقارنتها عبر الأسبوع" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding NavigateToSalesInvoicesCommand}" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Right">
                                        <TextBlock Text="عرض تقرير المبيعات ←" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                                    </Button>
                                </DockPanel>

                                <!-- Visual Bar Chart Container -->
                                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <ItemsControl ItemsSource="{Binding DailySalesTrend}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Bottom" Margin="8,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="140" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Sales Amount Label -->
                                                    <TextBlock Grid.Row="0" Text="{Binding FormattedSales}" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />

                                                    <!-- Vertical Bar Element -->
                                                    <Grid Grid.Row="1" VerticalAlignment="Bottom">
                                                        <Border Width="36" 
                                                                Height="{Binding BarHeightPercentage}" 
                                                                CornerRadius="6,6,0,0" 
                                                                VerticalAlignment="Bottom">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                    <GradientStop Color="#38e07b" Offset="0" />
                                                                    <GradientStop Color="#10b981" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <!-- Hover Tooltip -->
                                                            <Border.ToolTip>
                                                                <ToolTip>
                                                                    <StackPanel Margin="4">
                                                                        <TextBlock Text="{Binding DayName}" FontWeight="Bold" />
                                                                        <TextBlock Text="{Binding FormattedSales, StringFormat={}المبيعات: {0}}" />
                                                                        <TextBlock Text="{Binding OrdersCount, StringFormat={}الطلبات: {0} فاتورة}" />
                                                                        <TextBlock Text="{Binding ProfitAmount, StringFormat={}الأرباح: {0:N2} د.ل}" Foreground="Green" />
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Border.ToolTip>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Day Name Label -->
                                                    <TextBlock Grid.Row="2" Text="{Binding DayName}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,2" />

                                                    <!-- Orders Count Badge -->
                                                    <Border Grid.Row="3" Background="{DynamicResource PrimaryLightBrush}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding OrdersCount, StringFormat={}{0} طلب}" FontSize="10" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Top Selling Products Leaderboard -->
                        <Border Style="{StaticResource CardBorderStyle}" Background="{DynamicResource SurfaceBrush}" Padding="20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="الأصناف الأكثر مبيعاً" Style="{StaticResource H2TextBlockStyle}" />
                                        <TextBlock Text="المنتجات الأعلى طلباً وتحقيقاً للإيرادات في النظام" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding NavigateToProductsCommand}" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Right">
                                        <TextBlock Text="إدارة الأصناف ←" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                                    </Button>
                                </DockPanel>

                                <!-- List of Top Products -->
                                <ItemsControl ItemsSource="{Binding TopSellingProducts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon / Medal -->
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconProducts}" Fill="{DynamicResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Product Info -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding CategoryName}" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <!-- Share Bar -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <DockPanel Margin="0,0,0,4">
                                                            <TextBlock Text="حصة المبيعات" FontSize="10" Style="{StaticResource CaptionTextBlockStyle}" />
                                                            <TextBlock Text="{Binding PercentageOfTotalSales, StringFormat={}{0}%}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" />
                                                        </DockPanel>
                                                        <ProgressBar Value="{Binding PercentageOfTotalSales}" Maximum="100" Height="6" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource PrimaryBrush}" />
                                                    </StackPanel>

                                                    <!-- Total Revenue & Quantity -->
                                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedTotalSales}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding FormattedQuantity}" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State for Top Products -->
                                <Border Visibility="{Binding HasTopProducts, Converter={StaticResource InverseBoolToVisibilityConverter}}" Padding="20" HorizontalAlignment="Center">
                                    <TextBlock Text="لا توجد بيانات مبيعات كافية لعرض الأصناف الأكثر مبيعاً حتى الآن" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- ════════ RIGHT COLUMN ════════ -->
                    <StackPanel Grid.Column="1">

                        <!-- Low Stock Radar (Alerts) -->
                        <Border Style="{StaticResource CardBorderStyle}" Background="{DynamicResource SurfaceBrush}" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <StackPanel DockPanel.Dock="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconAlert}" Fill="{DynamicResource DangerBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="رادار النواقص وتنبيهات المخزون" Style="{StaticResource H2TextBlockStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="الأصناف التي وصلت أو تجاوزت حد إعادة الطلب" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding NavigateToStockCommand}" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Right">
                                        <TextBlock Text="المخزون ←" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" />
                                    </Button>
                                </DockPanel>

                                <!-- Low Stock Items List -->
                                <ItemsControl ItemsSource="{Binding LowStockAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding WarehouseName}" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" />
                                                            <TextBlock Text=" | حد الطلب: " Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" />
                                                            <TextBlock Text="{Binding MinStockLevel}" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" FontWeight="Bold" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Quantity Badge -->
                                                    <Border Grid.Column="1" Background="{DynamicResource DangerLightBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="المتبقي: " FontSize="11" Foreground="{DynamicResource DangerBrush}" />
                                                            <TextBlock Text="{Binding CurrentQuantity}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource DangerBrush}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Quick Action Purchase Order -->
                                                    <Button Grid.Column="2" 
                                                            Command="{Binding DataContext.NavigateToPurchaseOrdersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            Style="{StaticResource OutlinedButtonStyle}" 
                                                            Height="30" 
                                                            Padding="10,0" 
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="+ طلب شراء" FontSize="11" FontWeight="Bold" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State when all stock is healthy -->
                                <Border Visibility="{Binding HasLowStock, Converter={StaticResource InverseBoolToVisibilityConverter}}" Background="{DynamicResource SuccessLightBrush}" CornerRadius="10" Padding="16" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource SuccessBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="المخزون سليم! لا توجد أصناف تحت الحد الحرج حالياً." FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Recent Sales Invoices Stream -->
                        <Border Style="{StaticResource CardBorderStyle}" Background="{DynamicResource SurfaceBrush}" Padding="20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="آخر فواتير المبيعات الصادرة" Style="{StaticResource H2TextBlockStyle}" />
                                        <TextBlock Text="أحدث العمليات المنفذة في النظام" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding NavigateToSalesInvoicesCommand}" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Right">
                                        <TextBlock Text="كافة الفواتير ←" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                                    </Button>
                                </DockPanel>

                                <!-- Invoices List -->
                                <ItemsControl ItemsSource="{Binding RecentInvoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding InvoiceNumber}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding CustomerName}" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" />
                                                            <TextBlock Text=" • " Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" />
                                                            <TextBlock Text="{Binding FormattedTime}" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Payment Badge -->
                                                    <Border Grid.Column="1" Background="{DynamicResource PrimaryLightBrush}" CornerRadius="6" Padding="6,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PaymentMethod}" FontSize="10" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
                                                    </Border>

                                                    <!-- Amount -->
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedAmount}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State for Recent Invoices -->
                                <Border Visibility="{Binding HasRecentInvoices, Converter={StaticResource InverseBoolToVisibilityConverter}}" Padding="16" HorizontalAlignment="Center">
                                    <TextBlock Text="لا توجد فواتير مبيعات مسجلة اليوم حتى الآن" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>

                <!-- ── 4. QUICK ACTION SHORTCUTS TOOLBAR ── -->
                <TextBlock Text="إجراءات واختصارات سريعة" Style="{StaticResource H2TextBlockStyle}" Margin="0,0,0,14" />
                <UniformGrid Columns="5" Margin="-6,0,-6,10">

                    <!-- POS Shortcut -->
                    <Button Command="{Binding NavigateToPosCommand}" Style="{StaticResource CardButtonStyle}" Margin="6" Height="80" Padding="14">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPos}" Fill="{DynamicResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="نقطة البيع (POS)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="إصدار فاتورة سريعة" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Products Shortcut -->
                    <Button Command="{Binding NavigateToProductsCommand}" Style="{StaticResource CardButtonStyle}" Margin="6" Height="80" Padding="14">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconProducts}" Fill="{DynamicResource AccentBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="إدارة الأصناف" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="إضافة وتعديل المنتجات" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Purchase Invoices Shortcut -->
                    <Button Command="{Binding NavigateToPurchaseInvoicesCommand}" Style="{StaticResource CardButtonStyle}" Margin="6" Height="80" Padding="14">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource WarningLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPurchases}" Fill="{DynamicResource WarningBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="فواتير المشتريات" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="استلام بضاعة من مورد" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Stock Transfers & Adjustments Shortcut -->
                    <Button Command="{Binding NavigateToStockCommand}" Style="{StaticResource CardButtonStyle}" Margin="6" Height="80" Padding="14">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource SuccessLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconStock}" Fill="{DynamicResource SuccessBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="إدارة المخزون" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="أرصدة الصالات والمستودع" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Sales Invoices Reports Shortcut -->
                    <Button Command="{Binding NavigateToSalesInvoicesCommand}" Style="{StaticResource CardButtonStyle}" Margin="6" Height="80" Padding="14">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconInvoices}" Fill="{DynamicResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="سجل المبيعات" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="تقارير الفواتير والتحصيل" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                </UniformGrid>

            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════════ LOADING OVERLAY ════════════════════ -->
        <controls:LoadingOverlay Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>
