<UserControl x:Class="RetalSystemAPI.Desktop.Views.Tenants.TenantsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RetalSystemAPI.Desktop.Controls"
             FlowDirection="RightToLeft">
    <Grid Margin="32" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="الملف الشخصي للمستأجر" Style="{StaticResource H1TextBlockStyle}" />
                <TextBlock Text="إدارة بيانات المنشأة والإعدادات الخاصة بك" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="تحديث البيانات" Style="{StaticResource GhostButtonStyle}" Command="{Binding LoadProfileCommand}" HorizontalAlignment="Left" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="12,8" />
        </DockPanel>

        <!-- Alerts Section -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <!-- Error Message Banner -->
            <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="13" FontFamily="{StaticResource AppFontFamily}" FontWeight="SemiBold" />
            </Border>

            <!-- Success Message Banner -->
            <Border Background="#D1FAE5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#065F46" FontSize="13" FontFamily="{StaticResource AppFontFamily}" FontWeight="SemiBold" />
            </Border>
        </StackPanel>

        <!-- Profile Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <!-- Summary Header Card -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Profile Avatar Icon -->
                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Background="{StaticResource PrimaryBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Text="🏢" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Tenant Overview -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTenant.Name, FallbackValue='جاري التحميل...'}" Style="{StaticResource H2TextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="معرف المستأجر: " Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{Binding CurrentTenant.Id}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Bold" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Status Badge -->
                        <Border Grid.Column="2" VerticalAlignment="Center" Background="{Binding CurrentTenant.IsActive, Converter={StaticResource StatusToColorConverter}}" CornerRadius="16" Padding="14,6">
                            <TextBlock Text="{Binding CurrentTenant.IsActive, Converter={StaticResource StatusTextConverter}}" Foreground="White" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource AppFontFamily}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Detailed Settings Card -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="معلومات حساب المنشأة" Style="{StaticResource H2TextBlockStyle}" Margin="0,0,0,20" />

                        <!-- Tenant Name Input -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="اسم المستأجر / المنشأة" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBox Text="{Binding TenantName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DefaultTextBoxStyle}" Padding="12,10" />
                        </StackPanel>

                        <!-- Readonly Tenant ID -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="رمز المستأجر (ID)" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBox Text="{Binding CurrentTenant.Id}" IsReadOnly="True" Style="{StaticResource DefaultTextBoxStyle}" Background="#F3F4F6" Foreground="#6B7280" Padding="12,10" />
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                            <Button Content="حفظ التغييرات" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveProfileCommand}" Padding="24,10" Margin="0,0,12,0" />
                            <Button Content="إلغاء التعديل" Style="{StaticResource GhostButtonStyle}" Command="{Binding LoadProfileCommand}" Padding="16,10" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <controls:LoadingOverlay Grid.RowSpan="3" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>
