<UserControl x:Class="RetalSystemAPI.Desktop.Views.Customers.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:RetalSystemAPI.Desktop.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:customers="clr-namespace:RetalSystemAPI.Desktop.Models.Customers"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900" FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <Button Content="+ إضافة عميل جديد" Command="{Binding CreateCustomerCommand}" DockPanel.Dock="Left" Height="36" Padding="16,0" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryOnBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <TextBlock Text="👥 إدارة العملاء والحسابات" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Filter Bar Card -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="5,0,5,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource SurfaceHoverBrush}"/>

                <TextBlock Grid.Column="2" Text="النوع:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ComboBox Grid.Column="3" SelectedValue="{Binding SelectedType}" SelectedValuePath="Tag" Height="34" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="الكل" Tag="{x:Null}" IsSelected="True"/>
                    <ComboBoxItem Content="عادي" Tag="{x:Static customers:CustomerType.Regular}"/>
                    <ComboBoxItem Content="مميز (VIP)" Tag="{x:Static customers:CustomerType.Vip}"/>
                    <ComboBoxItem Content="جملة" Tag="{x:Static customers:CustomerType.Wholesale}"/>
                    <ComboBoxItem Content="شركة / مؤسسة" Tag="{x:Static customers:CustomerType.Corporate}"/>
                </ComboBox>

                <Button Grid.Column="4" Content="تحديث" Command="{Binding LoadCustomersCommand}" Margin="10,0,0,0" Padding="15,0" Height="34" Background="{DynamicResource TextPrimaryBrush}" Foreground="{DynamicResource SurfaceBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- DataGrid Card -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Customers}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" Background="Transparent" RowHeight="42">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم العميل" Binding="{Binding Name}" Width="1.8*"/>
                    <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="1*"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding TypeName}" Width="1.2*"/>
                    <DataGridTextColumn Header="الهاتف الأساسي" Binding="{Binding PrimaryPhone}" Width="1.4*"/>
                    <DataGridTextColumn Header="الرصيد الحالي" Binding="{Binding CurrentBalance, StringFormat={}{0:N2} د.ل}" Width="1.3*"/>
                    <DataGridTextColumn Header="سقف الائتمان" Binding="{Binding CreditLimit, StringFormat={}{0:N2} د.ل}" Width="1.3*"/>
                    <DataGridTemplateColumn Header="الحالة" Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IsActive, Converter={StaticResource StatusTextConverter}}" 
                                           Foreground="{Binding IsActive, Converter={StaticResource StatusToColorConverter}}" 
                                           FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="الإجراءات" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="تفعيل/تعطيل" Command="{Binding DataContext.ToggleActiveStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="6,4" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource TextPrimaryBrush}" Content="تعديل" Command="{Binding DataContext.EditCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                    <Button Style="{StaticResource TextButtonStyle}" Foreground="{DynamicResource DangerBrush}" Content="حذف" Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0" Padding="8,4" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,6" />
            <controls:PaginationControl CurrentPage="{Binding CurrentPage}" TotalPages="{Binding TotalPages}" PageSize="{Binding PageSize, Mode=TwoWay}" IsLoading="{Binding IsLoading}" NextPageCommand="{Binding NextPageCommand}" PrevPageCommand="{Binding PrevPageCommand}" />
        </StackPanel>
        <controls:EmptyStateControl Grid.Row="2" Title="لا توجد نتائج للعرض" Description="عدّل شروط البحث أو أضف سجلًا جديدًا للبدء.">
            <controls:EmptyStateControl.Style><Style TargetType="controls:EmptyStateControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Customers.Count}" Value="0"/><Condition Binding="{Binding IsLoading}" Value="False"/><Condition Binding="{Binding ErrorMessage}" Value="{x:Null}"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></controls:EmptyStateControl.Style>
        </controls:EmptyStateControl>
        <controls:LoadingOverlay Grid.RowSpan="4" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</UserControl>