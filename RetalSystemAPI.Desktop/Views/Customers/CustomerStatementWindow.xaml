<Window x:Class="RetalSystemAPI.Desktop.Views.Customers.CustomerStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RetalSystemAPI.Desktop.Controls"
        Title="كشف حساب عميل" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Customer Summary Header Card -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CreditLimit, StringFormat={}سقف الائتمان: {0:N2} د.ل}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="{Binding CustomerCode, StringFormat={}كود العميل: {0}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconStatement}" Fill="{DynamicResource PrimaryBrush}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding CustomerName, StringFormat={}كشف حساب العميل: {0}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- KPI Balance Summary Metrics -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,6,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="الرصيد الافتتاحي" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding OpeningBalance, StringFormat={}{0:N2} د.ل}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="4,0,4,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="الرصيد قبل الفترة" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding BalanceBeforePeriod, StringFormat={}{0:N2} د.ل}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="4,0,4,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي المدين (+ مبيعات)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TotalDebit, StringFormat={}{0:N2} د.ل}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="4,0,4,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي الدائن (- سدادات)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TotalCredit, StringFormat={}{0:N2} د.ل}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="6,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="الرصيد الحالي المستحق" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding CurrentBalance, StringFormat={}{0:N2} د.ل}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Date Range Filter -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="من تاريخ:" VerticalAlignment="Center" Margin="5,0,8,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="إلى تاريخ:" VerticalAlignment="Center" Margin="12,0,8,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate}" Height="34" VerticalContentAlignment="Center"/>

                <Button Grid.Column="4" Content="تحديث الكشف" Command="{Binding LoadStatementCommand}" Margin="12,0,0,0" Padding="16,0" Height="34" Background="{DynamicResource TextPrimaryBrush}" Foreground="{DynamicResource SurfaceBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Transactions DataGrid -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" Background="Transparent" RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding TransactionDate, StringFormat={}{0:yyyy/MM/dd HH:mm}}" Width="1.3*"/>
                    <DataGridTextColumn Header="نوع الحركة" Binding="{Binding TransactionTypeName}" Width="1.2*"/>
                    <DataGridTextColumn Header="المدين (+)" Binding="{Binding DebitAmount, StringFormat={}{0:N2} د.ل}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="الدائن (-)" Binding="{Binding CreditAmount, StringFormat={}{0:N2} د.ل}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="الرصيد بعد الحركة" Binding="{Binding BalanceAfter, StringFormat={}{0:N2} د.ل}" Width="1.3*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="1.1*"/>
                    <DataGridTextColumn Header="المستند" Binding="{Binding DocumentTypeName}" Width="1.1*"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <controls:ListFeedback Grid.Row="3" ItemsCount="{Binding Transactions.Count}" IsLoading="{Binding IsLoading}" Message="{Binding ErrorMessage}" RetryCommand="{Binding LoadStatementCommand}" />
        <controls:LoadingOverlay Grid.RowSpan="4" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</Window>
