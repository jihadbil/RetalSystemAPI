<Application x:Class="RetalSystemAPI.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RetalSystemAPI.Desktop"
             xmlns:converters="clr-namespace:RetalSystemAPI.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/LightTheme.xaml" />
                <ResourceDictionary Source="Resources/Typography.xaml" />
                <ResourceDictionary Source="Resources/Icons/AppIcons.xaml" />
                <ResourceDictionary Source="Resources/Styles/ButtonStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/TextBoxStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/ComboBoxStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/DataGridStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/CardStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/DialogStyles.xaml" />
<ResourceDictionary Source="Resources/Styles/WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:StatusTextConverter x:Key="StatusTextConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
            <converters:NumberToVisibilityConverter x:Key="NumberToVisibilityConverter" />
            <converters:StepVisibilityConverter x:Key="StepVisibilityConverter" />
            <converters:StepNumberToBrushConverter x:Key="StepNumberToBrushConverter" />
            <converters:ToastTypeToBrushConverter x:Key="ToastTypeToBrushConverter" />
            <converters:ToastTypeToLightBrushConverter x:Key="ToastTypeToLightBrushConverter" />
            <converters:ToastTypeToIconConverter x:Key="ToastTypeToIconConverter" />
            <converters:ActiveNavToBrushConverter x:Key="ActiveNavToBrushConverter" />
            <converters:ActiveNavToForegroundConverter x:Key="ActiveNavToForegroundConverter" />
            <converters:ActiveNavToBorderBrushConverter x:Key="ActiveNavToBorderBrushConverter" />
            <converters:TabIndexToActiveBrushConverter x:Key="TabIndexToActiveBrushConverter" />
            <converters:TabIndexToActiveForegroundConverter x:Key="TabIndexToActiveForegroundConverter" />
            <converters:TabIndexToActiveBorderBrushConverter x:Key="TabIndexToActiveBorderBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
