<UserControl x:Class="RetalSystemAPI.Desktop.Controls.ToastNotificationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:services="clr-namespace:RetalSystemAPI.Desktop.Services"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="350"
             FlowDirection="RightToLeft"
             IsHitTestVisible="True"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Margin="24,20,0,0" Foreground="{DynamicResource TextPrimaryBrush}">

    <ItemsControl ItemsSource="{Binding ActiveToasts}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type services:ToastItem}">
                <Border Margin="0,0,0,10"
                        Width="340"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{Binding Type, Converter={StaticResource ToastTypeToBrushConverter}}"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="14,12"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.18" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon Badge -->
                        <Border Grid.Column="0"
                                Width="32" Height="32"
                                CornerRadius="16"
                                Background="{Binding Type, Converter={StaticResource ToastTypeToLightBrushConverter}}"
                                Margin="0,0,10,0"
                                VerticalAlignment="Top">
                            <Path Data="{Binding Type, Converter={StaticResource ToastTypeToIconConverter}}"
                                  Fill="{Binding Type, Converter={StaticResource ToastTypeToBrushConverter}}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <!-- Text Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Message}"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="2"
                                Command="{Binding DismissCommand}"
                                Width="22" Height="22"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                VerticalAlignment="Top"
                                Margin="4,0,0,0">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
