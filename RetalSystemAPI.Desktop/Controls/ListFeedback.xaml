<UserControl x:Class="RetalSystemAPI.Desktop.Controls.ListFeedback"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" FlowDirection="RightToLeft"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <StackPanel x:Name="ErrorPanel" AutomationProperties.LiveSetting="Polite">
                    <TextBlock Text="تعذر تحديث القائمة" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Message, ElementName=Root}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,16"/>
                    <Button Content="إعادة المحاولة" Command="{Binding RetryCommand, ElementName=Root}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" MinHeight="40"/>
                </StackPanel>
                <StackPanel x:Name="EmptyPanel" AutomationProperties.LiveSetting="Polite">
                    <TextBlock Text="لا توجد نتائج لعرضها" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding EmptyDescription, ElementName=Root}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
