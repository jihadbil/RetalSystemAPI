<UserControl x:Class="RetalSystemAPI.Desktop.Controls.EmptyStateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="400"
             FlowDirection="RightToLeft"
             x:Name="root" Foreground="{DynamicResource TextPrimaryBrush}">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="32,28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Icon Illustration -->
            <Border Width="64" Height="64"
                    CornerRadius="32"
                    Background="{DynamicResource PrimaryLightBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
                <Path Data="{Binding IconData, ElementName=root, TargetNullValue={StaticResource IconEmptyState}}"
                      Fill="{DynamicResource PrimaryBrush}"
                      Width="28" Height="28"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>

            <!-- Title -->
            <TextBlock Text="{Binding Title, ElementName=root, FallbackValue='لا توجد بيانات متاحة'}"
                       FontFamily="{StaticResource AppFontFamily}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <!-- Description -->
            <TextBlock Text="{Binding Description, ElementName=root, FallbackValue='لم يتم العثور على أي نتائج أو سجلات تطابق شروط البحث.'}"
                       FontFamily="{StaticResource AppFontFamily}"
                       FontSize="13"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,6,0,18"
                       MaxWidth="320"
                       TextWrapping="Wrap" />

            <!-- Optional CTA Action Button -->
            <Button Content="{Binding ActionText, ElementName=root, FallbackValue='+ إضافة جديد'}"
                    Command="{Binding ActionCommand, ElementName=root}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding ActionText, ElementName=root, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                    Height="38"
                    Padding="20,0"
                    HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
