<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RetalSystemAPI.MAUI.ViewModels.Catalog"
             xmlns:models="clr-namespace:RetalSystemAPI.Models.DTOs.Catalog.Product;assembly=RetalSystemAPI.Models.DTOs"
             x:Class="RetalSystemAPI.MAUI.Views.Catalog.ProductsPage"
             x:DataType="vm:ProductsViewModel"
             Title="إدارة الأصناف والمنتجات"
             FlowDirection="RightToLeft"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto, Auto, *, Auto" RowSpacing="10" Padding="16">

        <!-- Top Header & Excel Action Buttons -->
        <Border Grid.Row="0">
            <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="دليل الأصناف والمنتجات" Style="{StaticResource Headline}" FontSize="18" VerticalOptions="Center" />

                <Button Grid.Column="1" Text="📊 تصدير Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource OutlinedButton}" HeightRequest="38" Padding="10,0"/>
                <Button Grid.Column="2" Text="📥 تحميل القالب" Command="{Binding DownloadTemplateCommand}" Style="{StaticResource OutlinedButton}" HeightRequest="38" Padding="10,0"/>
            </Grid>
        </Border>

        <!-- Search & Category Filter Bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 150" ColumnSpacing="8">
            <SearchBar Grid.Column="0" Text="{Binding SearchQuery}" SearchCommand="{Binding SearchCommand}" Placeholder="ابحث باسم الأصناف أو الباركود..." HeightRequest="44"/>
            <Picker Grid.Column="1" Title="التصنيف" ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedCategory}" HeightRequest="44"/>
        </Grid>

        <!-- Products List -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Products}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ProductResponseDto">
                    <Border Margin="0,0,0,10">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            
                            <!-- Icon / Image Placeholder -->
                            <Border Grid.Column="0" WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource PrimaryLight}" Padding="0">
                                <Label Text="📦" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <!-- Product Info -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontFamily="CairoBold" FontSize="16" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Code, StringFormat='الكود: {0}'}" Style="{StaticResource SubHeadline}" FontSize="12" />
                                    <Label Text="•" TextColor="{StaticResource TextMuted}" />
                                    <Label Text="{Binding CategoryName}" Style="{StaticResource SubHeadline}" FontSize="12" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Details Arrow -->
                            <Label Grid.Column="2" Text="◀" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" FontSize="16"/>

                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProductTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Pagination Controls -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Padding="8,0">
            <Button Grid.Column="0" Text="السابق" Command="{Binding PreviousPageCommand}" Style="{StaticResource OutlinedButton}" HeightRequest="36" Padding="14,0"/>
            <Label Grid.Column="1" Text="{Binding CurrentPage, StringFormat='صفحة {0}'}" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13" TextColor="{StaticResource TextMuted}" />
            <Button Grid.Column="2" Text="التالي" Command="{Binding NextPageCommand}" Style="{StaticResource OutlinedButton}" HeightRequest="36" Padding="14,0"/>
        </Grid>

    </Grid>
</ContentPage>
