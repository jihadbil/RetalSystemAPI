<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RetalSystemAPI.MAUI.ViewModels.Auth"
             x:Class="RetalSystemAPI.MAUI.Views.Auth.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="إنشاء حساب جديد"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView VerticalOptions="Center">
        <VerticalStackLayout Padding="24" Spacing="20" MaximumWidthRequest="420" HorizontalOptions="Center">

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="إنشاء حساب جديد" Style="{StaticResource Headline}" HorizontalTextAlignment="Center" />
                <Label Text="قم بتعبئة بياناتك للبدء في استخدام النظام" Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="اسم المنشأة / المستأجر" FontSize="14" FontFamily="CairoBold" />
                        <Border StrokeShape="RoundRectangle 8" Padding="4,0" BackgroundColor="{StaticResource Surface}">
                            <Entry Text="{Binding TenantName}" Placeholder="اسم المقاهي / المنشأة..." />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="اسم المستخدم" FontSize="14" FontFamily="CairoBold" />
                        <Border StrokeShape="RoundRectangle 8" Padding="4,0" BackgroundColor="{StaticResource Surface}">
                            <Entry Text="{Binding UserName}" Placeholder="اسم المستخدم..." />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="البريد الإلكتروني" FontSize="14" FontFamily="CairoBold" />
                        <Border StrokeShape="RoundRectangle 8" Padding="4,0" BackgroundColor="{StaticResource Surface}">
                            <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="email@example.com" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="كلمة المرور" FontSize="14" FontFamily="CairoBold" />
                        <Border StrokeShape="RoundRectangle 8" Padding="4,0" BackgroundColor="{StaticResource Surface}">
                            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="••••••••" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}" HorizontalTextAlignment="Center" />

                    <Button Text="تسجيل الحساب" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Margin="0,8,0,0"/>

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                <Label Text="لديك حساب بالفعل؟" TextColor="{StaticResource TextMuted}" />
                <Label Text="تسجيل الدخول" TextColor="{StaticResource Primary}" FontFamily="CairoBold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
