<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RetalSystemAPI.MAUI.ViewModels.Auth"
             x:Class="RetalSystemAPI.MAUI.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="تسجيل الدخول"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView VerticalOptions="Center">
        <VerticalStackLayout Padding="24" Spacing="20" MaximumWidthRequest="420" HorizontalOptions="Center">

            <!-- Logo & Header -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Border WidthRequest="72" HeightRequest="72" StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Primary}" HorizontalOptions="Center" Padding="0">
                    <Label Text="🌿" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                
                <Label Text="Emerald Management Pro" Style="{StaticResource Headline}" HorizontalTextAlignment="Center" Margin="0,12,0,0" />
                <Label Text="أهلاً بك، يرجى تسجيل الدخول للمتابعة" Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Login Card -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="16">

                    <!-- Username Field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="اسم المستخدم" FontSize="14" FontFamily="CairoBold" />
                        <Border StrokeShape="RoundRectangle 8" Padding="4,0" BackgroundColor="{StaticResource Surface}">
                            <Entry Text="{Binding UserName}" Placeholder="أدخل اسم المستخدم..." ReturnType="Next" />
                        </Border>
                    </VerticalStackLayout>


                    <!-- Password Field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="كلمة المرور" FontSize="14" FontFamily="CairoBold" />
                        <Border StrokeShape="RoundRectangle 8" Padding="4,0" BackgroundColor="{StaticResource Surface}">
                            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="••••••••" ReturnType="Done" ReturnCommand="{Binding LoginCommand}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error Message -->
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}" HorizontalTextAlignment="Center" />

                    <!-- Submit Button -->
                    <Button Text="تسجيل الدخول" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Margin="0,8,0,0"/>

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Border>

            <!-- Register Navigation Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                <Label Text="ليس لديك حساب؟" TextColor="{StaticResource TextMuted}" />
                <Label Text="إنشاء حساب جديد" TextColor="{StaticResource Primary}" FontFamily="CairoBold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
