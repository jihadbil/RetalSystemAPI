<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RetalSystemAPI.MAUI.ViewModels"
             x:Class="RetalSystemAPI.MAUI.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="الرئيسية"
             FlowDirection="RightToLeft"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <!-- Welcome Header Card -->
            <Border Style="{StaticResource CardStyle}" BackgroundColor="{StaticResource Surface}">
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="مرحباً بك في Emerald Management Pro 🌿" Style="{StaticResource Headline}" FontSize="20" />
                        <Label Text="نظام إدارة الأصناف والفروع والمستأجرين المتكامل" Style="{StaticResource SubHeadline}" FontSize="14" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1" Text="تسجيل الخروج" Command="{Binding LogoutCommand}" Style="{StaticResource OutlinedButton}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Stats Grid -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="12">

                <!-- Products Card -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="📦" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{Binding ProductsCount}" FontSize="28" FontFamily="CairoBold" HorizontalOptions="Center" TextColor="{StaticResource Primary}" />
                        <Label Text="إجمالي المنتجات" Style="{StaticResource SubHeadline}" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Branches Card -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🏬" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{Binding BranchesCount}" FontSize="28" FontFamily="CairoBold" HorizontalOptions="Center" TextColor="{StaticResource Primary}" />
                        <Label Text="إجمالي الفروع" Style="{StaticResource SubHeadline}" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Categories Card -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🏷️" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{Binding CategoriesCount}" FontSize="28" FontFamily="CairoBold" HorizontalOptions="Center" TextColor="{StaticResource Primary}" />
                        <Label Text="التصنيفات" Style="{StaticResource SubHeadline}" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Quick Actions -->
            <Label Text="إجراءات سريعة" Style="{StaticResource Headline}" FontSize="18" Margin="0,10,0,0"/>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="12" RowDefinitions="Auto, Auto" RowSpacing="12">
                <Button Grid.Row="0" Grid.Column="0" Text="إدارة الأصناف والمنتجات" Clicked="NavigateToProducts" HeightRequest="60" />
                <Button Grid.Row="0" Grid.Column="1" Text="إدارة التصنيفات" Clicked="NavigateToCategories" Style="{StaticResource OutlinedButton}" HeightRequest="60" />
                <Button Grid.Row="1" Grid.Column="0" Text="إدارة الفروع" Clicked="NavigateToBranches" Style="{StaticResource OutlinedButton}" HeightRequest="60" />
                <Button Grid.Row="1" Grid.Column="1" Text="إدارة المستأجرين" Clicked="NavigateToTenants" Style="{StaticResource OutlinedButton}" HeightRequest="60" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
