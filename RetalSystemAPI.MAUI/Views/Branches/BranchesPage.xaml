<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RetalSystemAPI.MAUI.ViewModels.Branches"
             xmlns:models="clr-namespace:RetalSystemAPI.Models.DTOs.Branch;assembly=RetalSystemAPI.Models.DTOs"
             x:Class="RetalSystemAPI.MAUI.Views.Branches.BranchesPage"
             x:DataType="vm:BranchesViewModel"
             Title="إدارة الفروع"
             FlowDirection="RightToLeft"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto, *">

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="16,16,16,8">
            <Label Text="قائمة الفروع المسجلة للمستأجر" Style="{StaticResource Headline}" FontSize="18" />
        </Border>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Branches}" Margin="16,0,16,16">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BranchResponseDto">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding Name}" FontFamily="CairoBold" FontSize="16" />
                                <Label Text="{Binding Address}" Style="{StaticResource SubHeadline}" FontSize="13" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1" Text="{Binding IsActive, Converter={StaticResource BoolToActiveTextConverter}}" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BranchesViewModel}}, Path=ToggleActiveCommand}" CommandParameter="{Binding .}" Style="{StaticResource OutlinedButton}" HeightRequest="36" Padding="12,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
