<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Emerald Management Pro - Light Mode Color Palette -->
    <Color x:Key="Primary">#38e07b</Color>
    <Color x:Key="PrimaryDark">#2dbf67</Color>
    <Color x:Key="PrimaryLight">#e6fbf0</Color>
    
    <Color x:Key="AppBackground">#f6f8f7</Color>
    <Color x:Key="Surface">#ffffff</Color>
    
    <Color x:Key="TextPrimary">#111827</Color>
    <Color x:Key="TextMuted">#6b7280</Color>
    <Color x:Key="BorderColor">#e5e7eb</Color>
    
    <Color x:Key="Danger">#ef4444</Color>
    <Color x:Key="Warning">#f59e0b</Color>
    <Color x:Key="Info">#3b82f6</Color>
    
    <Color x:Key="White">#ffffff</Color>
    <Color x:Key="Black">#000000</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
</ResourceDictionary>